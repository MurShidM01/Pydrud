# Pydrud project configuration.
#
# Packages below are installed into the APK by Chaquopy at build time —
# manage them with 'pydrud pip add <name>' / 'pydrud pip remove <name>'.
# Only packages verified to work on Android are accepted; run
# 'pydrud pip list --all' to see them.

[app]
name = "{{ project_name }}"
package = "{{ package }}"
scheme = "{{ scheme }}"

[theme]
# The brand colour the design system is generated from. Change it and run
# `pydrud sync` to regenerate the native theme resources, or call
# Theme.seed(...) in your app to re-theme at runtime.
seed = "{{ seed_color | default("#FF6366F1") }}"

[python.packages]
{% for requirement in pip_packages | default([]) -%}
{{ requirement }} = ""
{% endfor %}
