{% else %}
"""
{{ project_name }} — entry point.

The starter opens to Heartbeat: one calm screen with a softly pulsing
heart, a live BPM reading, a tiny ECG trace and one compact transport
button. Its visual system lives in ``app/theme.py`` and ``app/theme.pss``;
its reactive values live in ``app/state.py``.

Edit the screen or the stylesheet, then run ``pydrud run`` for interactive
Flutter-style hot reload (press ``r`` for hot reload, ``R`` for hot restart).
"""

import os

from pydrud import App

from app import theme
from app.config import APP_NAME
from app.jobs import JOBS, job, run_background_job   # noqa: F401 (Java entry)
from app.runtime import bind, current, refresh, router
from app.screens import heartbeat_screen
from app.screens.heartbeat import pause

theme.use_light()

# ── Routes ──────────────────────────────────────────────────────────────────

router.define("heartbeat", heartbeat_screen)
router.initial("heartbeat")


def main(page):
    """Build the current screen (called on startup and on every update)."""
    router.build_root()(page)


def start_app():
    """Called by MainActivity via Chaquopy."""
    app = bind(App(
        target=router.build_root(),
        title=APP_NAME,
        stylesheet=os.path.join(os.path.dirname(__file__), "theme.pss"),
    ))
    app.attach_router(router)
    # A 60 fps loop has no business running behind the home screen, so the
    # rhythm stops with the app and waits to be started again.
    app.on_lifecycle("pause", lambda _data: pause())
    # Deep links ({{ scheme }}://heartbeat), launcher shortcuts and push
    # notification taps all arrive here and are routed automatically.
    app.on_deep_link(lambda url: print(f"[{APP_NAME}] link:", url))
    app.run()


__all__ = ["JOBS", "bind", "current", "job", "main", "pause", "refresh",
           "router", "run_background_job", "start_app"]
{% endif %}
