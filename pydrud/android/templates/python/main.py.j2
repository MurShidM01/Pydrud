"""
{{ project_name }} — built with Pydrud.

This starter app is a working tour of the framework: Scaffold + AppBar,
reactive State, a counter, a to-do list with keyed rows, input widgets and
multi-screen navigation with hardware back-button support.

Edit this file, then run `pydrud run` (or `pydrud run --watch`).
"""

from pydrud import (
    Animation, App, AppBar, Avatar, Badge, Button, Card, Center, Chart,
    Checkbox, Chip, Colors, Column, Container, Dismissible, Divider,
    EdgeInsets, FadeIn, FloatingActionButton, GestureDetector, Icon, Icons,
    ListTile, ListView, ProgressBar, Rating, Responsive, Router, Row,
    Scaffold, SearchBar, SegmentedButton, SizedBox, Slider, State, Switch,
    Tab, Tabs, Text, TextField,
)

# ── State ───────────────────────────────────────────────────────────────────

counter = State(0)
todos = State([])          # list[str]
new_todo = State("")
dark_mode = State(False)
volume = State(40.0)
agreed = State(False)
tab_index = State(0)
interests = State({"Python", "Android"})
rating = State(4.0)
query = State("")

router = Router()
app: App | None = None


def refresh():
    """Re-render the current screen."""
    if app is not None:
        app.update()


# ── Screens ─────────────────────────────────────────────────────────────────


def home_screen(page):
    page.bgcolor = Colors.BACKGROUND if not dark_mode.value else "#FF111827"
    text_color = Colors.TEXT if not dark_mode.value else Colors.WHITE

    def increment(_event):
        counter.value += 1
        refresh()

    def reset(_event):
        counter.value = 0
        page.toast("Counter reset")
        refresh()

    page.add(
        Scaffold(
            key="home",
            app_bar=AppBar(
                title="{{ project_name }}",
                key="home_bar",
                bg_color=Colors.PRIMARY,
                actions=[
                    Icon(Icons.DASHBOARD, key="to_showcase", color=Colors.WHITE)
                    .on_click(lambda _e: router.push("showcase")),
                    Icon(Icons.SETTINGS, key="to_settings", color=Colors.WHITE)
                    .on_click(lambda _e: router.push("settings")),
                ],
            ),
            body=Column(
                scroll=True,
                spacing=12,
                children=[
                    SizedBox(height=16),

                    Center(child=Text(
                        str(counter.value),
                        key="counter_value",
                        size=Responsive.text(64),
                        weight=700,
                        color=Colors.PRIMARY,
                    )),
                    Center(child=Text(
                        "taps so far",
                        size=Responsive.text(14),
                        color=Colors.TEXT_SECONDARY,
                    )),

                    Center(child=Row(spacing=12, children=[
                        Button("Reset", key="reset_btn", variant="outlined",
                               bg_color=Colors.PRIMARY).on_click(reset),
                        Button("Tap me", key="tap_btn",
                               bg_color=Colors.PRIMARY).on_click(increment),
                    ])),

                    Divider(),

                    Card(child=Column(spacing=8, children=[
                        Text("To-do", size=18, weight=700, color=text_color),
                        Row(spacing=8, children=[
                            TextField(
                                new_todo.value,
                                key="todo_input",
                                hint="What needs doing?",
                                expand=1,
                            ).on_change(_set_new_todo),
                            Button("Add", key="todo_add",
                                   bg_color=Colors.SUCCESS).on_click(_add_todo),
                        ]),
                        _todo_list(),
                    ])),

                    SizedBox(height=80),
                ],
            ),
            floating_action_button=FloatingActionButton(
                "+", key="fab", bg_color=Colors.PRIMARY, on_click=increment,
            ),
        )
    )


def _todo_list():
    if not todos.value:
        return Text("Nothing yet — add your first task.",
                    key="todo_empty", size=13, color=Colors.TEXT_DISABLED)

    rows = []
    for index, item in enumerate(todos.value):
        rows.append(
            Container(
                key=f"todo_row_{item}",
                padding=EdgeInsets.symmetric(vertical=6),
                child=Row(key=f"todo_rowbody_{item}", spacing=8, children=[
                    Text(f"{index + 1}.", key=f"todo_num_{item}",
                         size=14, color=Colors.TEXT_DISABLED),
                    Text(item, key=f"todo_text_{item}", size=15, expand=1),
                    Icon(Icons.DELETE, key=f"todo_del_{item}", size=20,
                         color=Colors.ERROR).on_click(_remove_todo(item)),
                ]),
            )
        )
    return Column(key="todo_list", children=rows)


def _set_new_todo(event):
    new_todo.value = event.get("value", "")


def _add_todo(_event):
    text = (new_todo.value or "").strip()
    if not text:
        return
    todos.value = todos.value + [text]
    new_todo.value = ""
    refresh()


def _remove_todo(item):
    def handler(_event):
        todos.value = [t for t in todos.value if t != item]
        refresh()
    return handler


def settings_screen(page):
    page.bgcolor = Colors.BACKGROUND if not dark_mode.value else "#FF111827"

    def toggle_dark(event):
        dark_mode.value = bool(event.get("value"))
        page.set_system_ui(
            status_bar_color="#FF111827" if dark_mode.value else Colors.PRIMARY,
            icon_brightness="light",
        )
        refresh()

    def set_volume(event):
        volume.value = float(event.get("value", 0))
        refresh()

    def set_agreed(event):
        agreed.value = bool(event.get("value"))
        refresh()

    page.add(
        Scaffold(
            key="settings",
            app_bar=AppBar(
                title="Settings",
                key="settings_bar",
                bg_color=Colors.PRIMARY,
                leading=Icon(Icons.BACK, key="settings_back", color=Colors.WHITE)
                .on_click(lambda _e: router.pop()),
            ),
            body=Column(scroll=True, spacing=8, children=[
                SizedBox(height=12),
                Card(child=Column(spacing=12, children=[
                    Switch("Dark mode", key="dark_switch",
                           active=dark_mode.value).on_change(toggle_dark),
                    Divider(),
                    Text(f"Volume: {int(volume.value)}", key="volume_label", size=14),
                    Slider(volume.value, key="volume_slider",
                           min=0, max=100).on_change(set_volume),
                    Divider(),
                    Checkbox("I agree to the terms", key="agree_box",
                             checked=agreed.value).on_change(set_agreed),
                ])),
                Center(child=Button(
                    "Show snackbar", key="snack_btn", bg_color=Colors.SECONDARY,
                ).on_click(lambda _e: page.snack_bar("Settings saved", action="OK"))),
            ]),
        )
    )


def showcase_screen(page):
    """A tour of the Pydrud 1.2 component library."""
    page.bgcolor = Colors.BACKGROUND if not dark_mode.value else "#FF111827"

    def select_tab(event):
        tab_index.value = int(event.value or 0)
        refresh()

    def toggle_interest(name):
        def handler(event):
            chosen = set(interests.value)
            if event.value:
                chosen.add(name)
            else:
                chosen.discard(name)
            interests.value = chosen
            refresh()
        return handler

    def set_rating(event):
        rating.value = float(event.value or 0)
        refresh()

    def search(event):
        query.value = str(event.value or "")
        refresh()

    def confirm_delete(_event):
        page.dialog.confirm(
            "Delete this item?", title="Are you sure?",
        ).then(lambda yes: page.toast("Deleted" if yes else "Kept"))

    def save_note(_event):
        page.storage.set("note", query.value)
        page.haptics.impact("light")
        page.snack_bar("Saved to device storage", action="OK")

    components_tab = Column(spacing=12, children=[
        SizedBox(height=8),
        Row(key="showcase_people", spacing=8, children=[
            Avatar(initials="AD", key="avatar_ad"),
            Avatar(icon=Icons.PERSON, key="avatar_icon", bg=Colors.TEAL),
            Badge(3, key="avatar_badge",
                  child=Icon(Icons.NOTIFICATIONS, key="bell", size=28)),
        ]),
        SearchBar(query.value, key="showcase_search",
                  hint="Search components").on_change(search),
        Row(key="showcase_chips", spacing=8, children=[
            Chip(name, key=f"chip_{name}", variant="filter",
                 selected=name in interests.value).on_change(
                     toggle_interest(name))
            for name in ("Python", "Android", "Flutter")
        ]),
        Card(key="showcase_list", child=Column(children=[
            ListTile("Profile", key="tile_profile", subtitle="Name and photo",
                     leading=Icons.PERSON, trailing=Icons.CHEVRON_RIGHT),
            Divider(key="tile_divider"),
            ListTile("Notifications", key="tile_notify",
                     subtitle="Sounds and badges", leading=Icons.NOTIFICATIONS,
                     trailing=Icons.CHEVRON_RIGHT),
        ])),
        Dismissible(key="swipe_row", background=Colors.ERROR,
                    child=Card(key="swipe_card", child=Text(
                        "Swipe me away", key="swipe_text")),
                    on_dismiss=lambda _e: page.toast("Dismissed")),
        Rating(rating.value, key="showcase_rating").on_change(set_rating),
        Text(f"You rated this {rating.value:g}/5", key="rating_label", size=13,
             color=Colors.TEXT_SECONDARY),
    ])

    data_tab = Column(spacing=12, children=[
        SizedBox(height=8),
        Text("Weekly taps", key="chart_title", size=16, weight=600),
        Chart([counter.value, 3, 7, 4, 9, 6, 8], key="showcase_chart",
              kind="bar", labels=["M", "T", "W", "T", "F", "S", "S"]),
        ProgressBar(min(counter.value / 10, 1.0), key="goal_bar"),
        Text(f"Daily goal: {min(counter.value, 10)}/10", key="goal_label",
             size=13, color=Colors.TEXT_SECONDARY),
        SegmentedButton(["Day", "Week", "Month"], key="range_picker",
                        selected=1),
    ])

    actions_tab = Column(spacing=12, children=[
        SizedBox(height=8),
        FadeIn(key="actions_intro", animation=Animation.normal(),
               child=Text("Native power, from Python.", key="actions_text",
                          size=16, weight=600)),
        Button("Confirm dialog", key="dialog_btn").on_click(confirm_delete),
        Button("Save to storage", key="storage_btn",
               bg_color=Colors.SECONDARY).on_click(save_note),
        Button("Share this app", key="share_btn", variant="outlined").on_click(
            lambda _e: page.share.text("Built with Pydrud!")),
        GestureDetector(
            key="gesture_box",
            child=Container(key="gesture_card", bg=Colors.SURFACE,
                            padding=24, border_radius=12,
                            child=Text("Double-tap or swipe me",
                                       key="gesture_text")),
            on_double_tap=lambda _e: page.toast("Double tap!"),
            on_swipe_left=lambda _e: page.toast("Swiped left"),
            on_swipe_right=lambda _e: page.toast("Swiped right"),
        ),
    ])

    page.add(
        Scaffold(
            key="showcase",
            app_bar=AppBar(
                title="Showcase",
                key="showcase_bar",
                bg_color=Colors.PRIMARY,
                leading=Icon(Icons.BACK, key="showcase_back",
                             color=Colors.WHITE).on_click(
                                 lambda _e: router.pop()),
            ),
            body=Column(scroll=True, children=[
                Tabs(
                    [
                        Tab("Components", content=components_tab),
                        Tab("Data", content=data_tab),
                        Tab("Actions", content=actions_tab),
                    ],
                    key="showcase_tabs",
                    selected=tab_index.value,
                ).on_change(select_tab),
            ]),
        )
    )


# ── Entry Point ─────────────────────────────────────────────────────────────

router.define("home", home_screen)
router.define("showcase", showcase_screen)
router.define("settings", settings_screen)
router.initial("home")


def main(page):
    """Build the current screen (called on startup and on every update)."""
    router.build_root()(page)


def start_app():
    """Called by MainActivity via Chaquopy."""
    global app
    app = App(target=router.build_root(), title="{{ project_name }}")
    app.attach_router(router)
    app.run()
