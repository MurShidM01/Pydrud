"""Generated Pydrud configuration for the {{ project_name }} app.

Edit pydrud.yaml and run `pydrud sync` for Android projects.
"""

# ── App metadata ─────────────────────────────────────────────────────────────
APP_NAME = "{{ project_name }}"
PACKAGE = "{{ package }}"
VERSION = "{{ version_name | default("1.0.0") }}"
VERSION_CODE = {{ version_code | default(1) }}
ASSETS_DIR = "{{ assets_dir | default("assets") }}"
{% if runtime == "chaquopy" %}
PERMISSIONS = [{% for permission in permissions | default([]) %}"{{ permission }}"{% if not loop.last %}, {% endif %}{% endfor %}]
CAPABILITIES = [{% for capability in capabilities_list | default([]) %}"{{ capability }}"{% if not loop.last %}, {% endif %}{% endfor %}]

# ── Android SDK ──────────────────────────────────────────────────────────────
MIN_SDK = {{ min_sdk }}
TARGET_SDK = {{ target_sdk }}
COMPILE_SDK = {{ compile_sdk | default(target_sdk) }}

# ── Local Chaquopy bridge ────────────────────────────────────────────────────
BRIDGE_HOST = "127.0.0.1"
BRIDGE_PORT = 8595
{% endif %}
