"""A calm, focused counter screen for {{ project_name }}.

The generated app is intentionally simple: a polished total, clear controls,
and one prominent floating action button to add the next count.
"""

from pydrud import (
    AppBar, Button, Colors, Column, Container, FloatingActionButton, Icon,
    Icons, Responsive, Row, Scaffold, Spacing, Text, Theme,
)

from app.config import APP_NAME, APP_TAGLINE
from app.state import counter
from app.components import page_body


def playground_screen(page):
    """Build the responsive counter app into *page*."""
    def increment(_event):
        counter.value += 1
        page.update()

    def decrement(_event):
        # A tally starts at zero; don't let the secondary action underflow it.
        counter.value = max(0, counter.value - 1)
        page.update()

    def reset(_event):
        counter.value = 0
        page.update()

    page.bgcolor = Theme.background
    count_label = "count" if counter.value == 1 else "counts"
    count_hint = (
        "A fresh start is a good place to begin."
        if counter.value == 0
        else "Every little step adds up."
    )

    page.add(Scaffold(
        key="counter_screen",
        class_="counter-screen",
        app_bar=AppBar(
            title=APP_NAME,
            key="counter_app_bar",
            bg_color=Theme.background,
            color=Theme.text,
            divider=False,
        ),
        body=page_body("counter", [
            Container(
                key="counter_intro",
                width="match",
                class_="counter-intro",
                child=Column(
                    key="counter_intro_content",
                    spacing=Spacing.SM,
                    children=[
                        Text("YOUR PERSONAL TALLY", key="counter_eyebrow",
                             class_="counter-eyebrow"),
                        Text("Count the things that matter.",
                             key="counter_heading",
                             class_="counter-heading"),
                        Text(APP_TAGLINE, key="counter_tagline",
                             class_="counter-subtitle"),
                    ],
                ),
            ),
            Container(
                key="counter_panel",
                width="match",
                bg=Theme.surface,
                class_="counter-panel",
                child=Column(
                    key="counter_panel_content",
                    spacing=Spacing.SM,
                    horizontal_alignment="center",
                    children=[
                        Container(
                            key="counter_icon_wrap",
                            width=52,
                            height=52,
                            class_="counter-icon-wrap",
                            child=Icon(Icons.TRENDING_UP, size=24,
                                       color=Colors.WHITE),
                        ),
                        Text("TOTAL COUNT", key="counter_caption",
                             class_="counter-caption"),
                        Text(f"{counter.value:,}", key="counter_value",
                             class_="counter-value", max_lines=1,
                             text_align="center"),
                        Text(count_label, key="counter_unit",
                             class_="counter-unit"),
                        Container(key="counter_accent_rule", width=44,
                                  height=4, class_="counter-accent-rule"),
                        Text(count_hint, key="counter_hint",
                             class_="counter-hint", text_align="center"),
                    ],
                ),
            ),
            Row(
                key="counter_actions",
                class_="counter-actions",
                spacing=Spacing.SM,
                horizontal_alignment="center",
                vertical_alignment="center",
                children=[
                    Button(
                        "−1",
                        key="dec_btn",
                        icon=Icons.REMOVE,
                        variant="tonal",
                        size="md",
                        class_="counter-decrement",
                        disabled=counter.value <= 0,
                        tooltip="Decrease the total by one",
                        semantics="Decrease the counter by one",
                        on_click=decrement,
                    ),
                    Button(
                        "Reset",
                        key="reset_btn",
                        icon=Icons.REFRESH,
                        variant="text",
                        size="md",
                        class_="counter-reset",
                        disabled=counter.value <= 0,
                        tooltip="Reset the total to zero",
                        semantics="Reset the counter to zero",
                        on_click=reset,
                    ),
                ],
            ),
        ]),
        floating_action_button=FloatingActionButton(
            key="inc_btn",
            icon=Icons.ADD,
            class_="counter-fab",
            tooltip="Add one to your total",
            semantics="Add one to the counter",
            on_click=increment,
        ),
        bg_color=Theme.background,
        content_max_width=Responsive.value(
            compact=520, medium=640, expanded=760, large=880, xlarge=960,
        ),
    ))
