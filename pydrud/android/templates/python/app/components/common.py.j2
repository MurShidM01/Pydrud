"""Small, reusable pieces of the Heartbeat screen.

Anything that is not specific to one screen lives here, so a second screen
can pick it up unchanged. The screen modules import from :mod:`app.components`
rather than reaching into each other.
"""

from pydrud import Container, Row, Text

from app import theme


def session_chip(label: str, *, live: bool) -> Row:
    """The top-bar chip: a status dot and a word.

    The dot is a quiet grey at rest and takes the heart's colour while the
    rhythm is running.
    """
    return Row(
        key="hb_session",
        spacing=6,
        main_axis_size="min",
        vertical_alignment="center",
        children=[
            Container(
                key="hb_session_dot",
                class_="hb-session-dot",
                style={"bg": theme.HEART} if live else {},
            ),
            Text(label, key="hb_session_text", class_="hb-session-text"),
        ],
    )


def footnote(label: str) -> Container:
    """A quiet, centred label — the last line on the screen."""
    return Container(
        key="hb_bottom",
        class_="hb-bottom",
        width="match",
        alignment="center",
        child=Text(label, key="hb_footnote", class_="hb-footnote"),
    )
