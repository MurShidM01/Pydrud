"""Application state.

A :class:`~pydrud.State` is a named, reactive value that outlives the
screen that rendered it — it survives navigation and hot reload. Change
``.value`` in an event handler, call ``refresh()``, and every widget that
reads it re-renders. For bigger apps reach for ``pydrud.Store``, which
adds actions, selectors and time travel.
"""

from pydrud import State

counter = State(0, name="counter")            # the State & interaction demo
your_name = State("", name="your_name")       # live TextField demo
dark_mode = State(False, name="dark_mode")    # Switch demo — re-themes natively
liked = State(False, name="liked")            # Checkbox demo
amount = State(40.0, name="amount")           # Slider + ProgressBar demo
