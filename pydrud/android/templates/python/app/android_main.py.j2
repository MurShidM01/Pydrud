"""Standalone Android entry point for {{ project_name }}.

MANAGED FILE — regenerated by `pydrud sync`. Do not edit: put app code in
the other `app/` modules. Created by `pydrud init android` so the on-device
interpreter can boot this project without touching `app/main.py` (which
remains the `pydrud dev` desktop preview entry point).
"""

import os

from pydrud import App

import app.main as _preview_entry  # noqa: F401 (applies the theme + routes)
from app.config import APP_NAME
from app.runtime import bind, refresh, router


def main(page):
    """Build the current screen (called on startup and on every update)."""
    router.build_root()(page)


def start_app():
    """Called by MainActivity via Chaquopy.

    Importing ``app.main`` above has already applied the palette
    (``theme.use_light()``), so the screen is themed before the first frame.
    """
    app = bind(App(
        target=router.build_root(),
        title=APP_NAME,
        stylesheet=os.path.join(os.path.dirname(__file__), "theme.pss"),
    ))
    app.attach_router(router)
    # Deep links ({{ scheme }}://details), launcher shortcuts and push
    # notification taps all arrive here and are routed automatically.
    app.on_deep_link(lambda url: print(f"[{APP_NAME}] link:", url))
    app.run()


def run_background_job(name, inputs_json="{}"):
    """Entry point invoked by PydrudWorker.java. Never touches widgets."""
    try:
        from app.jobs import run_background_job as _run
    except ImportError:
        return f"no such job: {name}"
    return _run(name, inputs_json)


__all__ = ["bind", "main", "refresh", "router", "run_background_job",
           "start_app"]
