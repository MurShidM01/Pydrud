/*
 * Starter Pydrud Style Sheet (PSS).
 *
 * The generated counter screen is styled here rather than with scattered
 * inline values. Edit this file and save to re-skin the app with hot reload.
 */

.counter-screen {
    bg: #F7F8FA;
}

.page-content {
    spacing: 16;
}

.responsive-content {
    alignment: topCenter;
}

.counter-intro {
    padding: { left: 2, right: 2, top: 0, bottom: 0 };
}

.counter-eyebrow {
    font: { size: 12, weight: 700, color: {{ seed_color | default("#FF6366F1") }} };
}

.counter-heading {
    font: { size: 32, weight: 700, color: #182230 };
}

.counter-subtitle {
    font: { size: 15, weight: 400, color: #667085 };
}

.counter-panel {
    bg: #FFFFFF;
    border-radius: 28;
    padding: { all: 28 };
    elevation: 2;
}

.counter-icon-wrap {
    bg: {{ seed_color | default("#FF6366F1") }};
    border-radius: 18;
    alignment: center;
}

.counter-caption {
    font: { size: 12, weight: 700, color: #667085 };
}

.counter-value {
    font: { size: 76, weight: 700, color: {{ seed_color | default("#FF6366F1") }} };
    text-align: center;
}

.counter-unit {
    font: { size: 15, weight: 500, color: #667085 };
}

.counter-accent-rule {
    bg: {{ seed_color | default("#FF6366F1") }};
    border-radius: 999;
}

.counter-hint {
    font: { size: 13, weight: 400, color: #667085 };
}

.counter-actions {
    spacing: 8;
}

.counter-decrement {
    bg: #EEF0FF;
    border-radius: 16;
    padding: { horizontal: 18, vertical: 10 };
    font: { size: 14, weight: 700, color: {{ seed_color | default("#FF6366F1") }} };
}

.counter-reset {
    border-radius: 16;
    padding: { horizontal: 18, vertical: 10 };
    font: { size: 14, weight: 600, color: #667085 };
}

.counter-fab {
    bg: {{ seed_color | default("#FF6366F1") }};
    elevation: 6;
}
