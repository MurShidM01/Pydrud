"""App-wide constants. Change a value, save, and hot reload does the rest.

The colours live in :mod:`app.theme`; this module holds the numbers and
the words — the parts of the app you are most likely to want to tweak.
"""

#: The name shown in the top-left of the screen.
APP_NAME = "{{ project_name }}"
APP_VERSION = "1.0.0"

#: The resting heart rate the demo simulates, and the band it drifts in.
BPM_START = 72
BPM_MIN = 68
BPM_MAX = 78

#: The top-bar chip: a word and a dot colour for each session state.
IDLE_STATUS = "Ready"
RUNNING_STATUS = "Active"

#: The guidance line under the number.
IDLE_MESSAGE = "Tap Start to begin"
RUNNING_MESSAGE = "Rhythm is running"

#: The small, quiet label at the very bottom.
FOOTNOTE = "Visual rhythm"
