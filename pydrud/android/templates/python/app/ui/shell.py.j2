"""The page shell every screen is wrapped in.

One shell means one place to change the app bar, the gutter, how the
navigation adapts to tablets, and how back behaves.
"""

from pydrud import (
    AppBar, BottomNavigationBar, Center, Column, Container, EdgeInsets,
    NavigationRail, Responsive, Scaffold, Spacing, Theme,
)

from app.config import DESTINATIONS, ROUTES
from app.runtime import router


def shell(page, *, title, body, key, actions=None, fab=None):
    """A page: app bar, scrolling body with a readable gutter, navigation.

    On a phone the destinations sit in a bottom bar; on a tablet they move
    into a side rail and the content is centred at a comfortable width.
    """
    page.bgcolor = Theme.background
    index = ROUTES.index(key)
    gutter = Responsive.value(phone=Spacing.GUTTER, tablet=Spacing.XXL)

    content = Column(
        key=f"{key}_scroll",
        scroll=True,
        spacing=Spacing.LG,
        style={"padding": EdgeInsets(
            left=gutter, right=gutter, top=Spacing.LG,
            bottom=Spacing.HUGE + Spacing.XXL).to_dict()},
        children=body,
    )

    # Phones use the full width; wide screens centre the content so lines
    # stay readable instead of stretching edge to edge.
    body = content if not Responsive.is_tablet() else Center(
        key=f"{key}_center",
        child=Container(key=f"{key}_wrap", width=640, height="match",
                        child=content),
    )

    return Scaffold(
        key=key,
        app_bar=AppBar(title=title, key=f"{key}_bar", actions=actions or []),
        body=body,
        # Every visual property of the bar is yours: height, radius,
        # indicator shape, label behaviour, colours, motion.
        bottom_navigation=None if Responsive.is_tablet() else BottomNavigationBar(
            DESTINATIONS, key=f"{key}_nav", selected=index, on_change=navigate,
            height=Responsive.value(compact=64, medium=72),
            indicator="pill", indicator_width=Responsive.w(64),
            indicator_height=Responsive.h(32),
            label_behavior="always", label_size=11, selected_label_size=11,
            top_divider=True, animate=True, haptic=True),
        navigation_rail=NavigationRail(
            DESTINATIONS, key=f"{key}_rail", selected=index,
            on_change=navigate) if Responsive.is_tablet() else None,
        floating_action_button=fab,
    )


def navigate(event):
    """Move between destinations the way Android expects.

    Home is the start destination, so back always returns there instead
    of walking through every tab you visited.
    """
    index = int(event.value or 0)
    if not 0 <= index < len(ROUTES):
        return
    target = ROUTES[index]
    current = router.current_route
    if target == current:
        return
    if target == "home":
        router.pop_to_root()
    elif current == "home":
        router.push(target)
    else:
        router.replace(target)
