"""Tests for {{ project_name }}.

``AppTester`` boots the app against a protocol reference renderer, so these
run without an emulator or a platform build toolchain.
"""

import os
import sys
import unittest

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "src"))

from pydrud.testing import AppTester  # noqa: E402
from app.main import main  # noqa: E402
from app.runtime import router  # noqa: E402
from app.screens import heartbeat  # noqa: E402
from app.state import bpm, running  # noqa: E402


class TestApp(unittest.TestCase):
    def setUp(self):
        running.value = False
        bpm.value = 72
        heartbeat._anim.update(started=0.0, next_beat=0.0, beat_at=-99.0,
                               timer=None, page=None)
        router.reset()
        self.app = AppTester(main, title="{{ project_name }}").start()

    def tearDown(self):
        self.app.stop()

    def test_heartbeat_is_the_default_experience(self):
        self.assertTrue(self.app.shows("{{ project_name }}"))
        self.assertTrue(self.app.shows("Tap Start to begin"))
        self.assertTrue(self.app.shows("Visual rhythm"))
        self.assertEqual(self.app.prop("hb_number", "value"), "72")
        for key in ("hb_topbar", "hb_visual", "hb_glow", "hb_ring_one",
                    "hb_ring_two", "hb_heart", "hb_number", "hb_unit",
                    "hb_message", "hb_ecg", "hb_transport",
                    "hb_transport._icon", "hb_footnote"):
            with self.subTest(key=key):
                self.assertTrue(self.app.exists(key))
        self.assertFalse(self.app.shows("Nowhere"))

    def test_the_transport_button_starts_and_stops_the_rhythm(self):
        self.app.tap("hb_transport")
        self.assertTrue(self.app.shows("Rhythm is running"))
        self.assertTrue(self.app.shows("Active"))

        self.app.tap("hb_transport")
        self.assertTrue(self.app.shows("Tap Start to begin"))
        self.assertTrue(self.app.shows("Ready"))

    def test_the_stylesheet_styles_the_screen(self):
        from pydrud.core.styles.parser import parse_pss

        pss = os.path.join(
            os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
            "src", "app", "theme.pss")
        with open(pss, encoding="utf-8") as handle:
            sheet = parse_pss(handle.read(), filename="theme.pss")
        self.assertFalse([d for d in sheet.diagnostics if d.kind == "error"])
        self.assertGreater(len(sheet.rules), 10)

        # Fixed shapes and type come from the stylesheet…
        self.assertEqual(self.app.node("hb_glow").style.get("borderRadius"),
                         999)
        self.assertEqual(
            self.app.node("hb_footnote").style.get("font", {}).get("size"), 9)
        # …and the clamp()-driven sizes follow the live window.
        self.assertEqual(self.app.node("hb_number").style["font"]["size"],
                         heartbeat._layout()["number"])

    def test_the_reading_follows_the_window(self):
        """The design sizes the reading with clamp(); a narrow window shrinks
        it without a second layout."""
        wide = heartbeat._layout()["number"]
        self.app.device.resize(320, 640)
        self.app.settle()
        narrow = self.app.node("hb_number").style["font"]["size"]
        self.assertLess(narrow, wide)

    def test_the_reading_clips_instead_of_ellipsising(self):
        """A one-line reading must not flash a '…' while it re-styles."""
        style = self.app.node("hb_number").style
        self.assertEqual(style.get("maxLines"), 1)
        self.assertEqual(style.get("overflow"), "clip")

    def test_the_caption_and_button_clear_the_edges(self):
        # The caption centres: no trailing padding to dodge the button.
        self.assertNotIn("padding", self.app.node("hb_bottom").style)
        # The button keeps safe-area handling on, so the renderer lifts it
        # above the gesture bar rather than resting on it.
        self.assertTrue(
            self.app.node("hb_transport").style.get("safeAreaBottom", True))


if __name__ == "__main__":
    unittest.main()
