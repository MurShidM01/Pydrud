"""Tests for {{ project_name }}.

``AppTester`` boots the app against a protocol reference renderer, so these
run without an emulator or platform build toolchain.
"""

import os
import sys
import unittest

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "src"))

from pydrud.testing import AppTester  # noqa: E402
from app.main import main  # noqa: E402
from app.runtime import router  # noqa: E402
from app.state import counter  # noqa: E402


class TestApp(unittest.TestCase):
    def setUp(self):
        counter.value = 0
        router.reset()
        self.app = AppTester(main, title="{{ project_name }}").start()

    def tearDown(self):
        self.app.stop()

    def test_counter_screen_is_the_default_experience(self):
        self.assertTrue(self.app.shows("{{ project_name }}"))
        self.assertTrue(self.app.shows("Count the things that matter."))
        self.assertTrue(self.app.shows("A little progress, one tap at a time."))
        self.assertEqual(self.app.prop("counter_value", "value"), "0")
        self.assertTrue(self.app.prop("inc_btn", "_fab"))
        for key in ("counter_panel", "counter_actions", "dec_btn",
                    "reset_btn", "inc_btn"):
            with self.subTest(key=key):
                self.assertTrue(self.app.exists(key))
        self.assertFalse(self.app.exists("name_input"))
        self.assertFalse(self.app.shows("Pydrud Native Playground"))

    def test_floating_action_button_increments_the_total(self):
        self.app.tap("inc_btn")
        self.assertEqual(self.app.prop("counter_value", "value"), "1")
        self.app.tap("inc_btn")
        self.assertEqual(self.app.prop("counter_value", "value"), "2")
        self.assertEqual(self.app.prop("counter_unit", "value"), "counts")

    def test_decrement_and_reset_controls(self):
        self.app.tap("inc_btn")
        self.app.tap("inc_btn")
        self.app.tap("dec_btn")
        self.assertEqual(self.app.prop("counter_value", "value"), "1")
        self.app.tap("reset_btn")
        self.assertEqual(self.app.prop("counter_value", "value"), "0")
        self.assertEqual(self.app.prop("counter_unit", "value"), "counts")
        self.app.tap("dec_btn")
        self.assertEqual(self.app.prop("counter_value", "value"), "0")

    def test_starter_stylesheet_and_responsive_layout(self):
        from pydrud.core.styles.parser import parse_pss

        pss = os.path.join(
            os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
            "src", "app", "theme.pss")
        with open(pss, encoding="utf-8") as handle:
            sheet = parse_pss(handle.read(), filename="theme.pss")
        self.assertFalse([d for d in sheet.diagnostics if d.kind == "error"])
        self.assertGreater(len(sheet.rules), 10)

        panel = self.app.node("counter_panel")
        value = self.app.node("counter_value")
        self.assertEqual(panel.style.get("borderRadius"), 28)
        self.assertEqual(value.style.get("font", {}).get("size"), 76)

        # A wide window gets a centred, capped content column rather than a
        # phone-width screen stretched edge-to-edge.
        self.app.device.resize(1024, 768)
        self.app.settle()
        self.assertEqual(self.app.node("counter_wrap").style.get("width"), 720)


if __name__ == "__main__":
    unittest.main()
