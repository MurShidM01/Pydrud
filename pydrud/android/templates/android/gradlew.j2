#!/bin/sh
#
# Pydrud Gradle launcher.
#
# Works both as a normal Gradle wrapper (when gradle-wrapper.jar is present)
# and as a self-bootstrapping launcher: if the wrapper JAR is missing — which
# is the case for a freshly scaffolded Pydrud project, because Pydrud does not
# ship binaries — the Gradle distribution named in
# gradle/wrapper/gradle-wrapper.properties is downloaded once into
# ~/.gradle/pydrud-dists and reused from then on.
#

set -e

PRG="$0"
while [ -h "$PRG" ] ; do
    ls=$(ls -ld "$PRG")
    link=$(expr "$ls" : '.*-> \(.*\)$')
    case "$link" in
        /*) PRG="$link" ;;
        *)  PRG="$(dirname "$PRG")/$link" ;;
    esac
done
APP_HOME=$(cd "$(dirname "$PRG")" > /dev/null && pwd -P)

DEFAULT_JVM_OPTS="-Xmx2048m -Xms256m"
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
WRAPPER_PROPS="$APP_HOME/gradle/wrapper/gradle-wrapper.properties"

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

# ── Locate Java ───────────────────────────────────────────────────────────
if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
    [ -x "$JAVACMD" ] || die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME"
else
    JAVACMD="java"
    command -v java >/dev/null 2>&1 || \
        die "ERROR: no 'java' on PATH and JAVA_HOME is not set. Install JDK 17+ (see: pydrud doctor)."
fi

# ── Fast path: a real Gradle wrapper JAR is available ─────────────────────
if [ -f "$WRAPPER_JAR" ] ; then
    exec "$JAVACMD" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS \
        "-Dorg.gradle.appname=$(basename "$0")" \
        -classpath "$WRAPPER_JAR" \
        org.gradle.wrapper.GradleWrapperMain "$@"
fi

# ── Bootstrap path: download the distribution ourselves ───────────────────
DIST_URL=""
if [ -f "$WRAPPER_PROPS" ] ; then
    DIST_URL=$(grep '^distributionUrl=' "$WRAPPER_PROPS" | cut -d= -f2- | sed 's|\\:|:|g')
fi
[ -n "$DIST_URL" ] || DIST_URL="https://services.gradle.org/distributions/gradle-{{ gradle_version | default("8.14.4") }}-bin.zip"

DIST_NAME=$(basename "$DIST_URL" .zip)       # e.g. gradle-8.14.4-bin
GRADLE_VER=$(echo "$DIST_NAME" | sed 's/^gradle-//; s/-bin$//; s/-all$//')
DIST_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}/pydrud-dists"
GRADLE_BIN="$DIST_HOME/gradle-$GRADLE_VER/bin/gradle"

if [ ! -x "$GRADLE_BIN" ] ; then
    if command -v gradle >/dev/null 2>&1 ; then
        echo "[Pydrud] Using system Gradle ($(command -v gradle))"
        exec gradle "$@"
    fi

    echo "[Pydrud] Gradle $GRADLE_VER not found — downloading once..."
    echo "[Pydrud]   $DIST_URL"
    mkdir -p "$DIST_HOME"
    ZIP="$DIST_HOME/$DIST_NAME.zip"

    if command -v curl >/dev/null 2>&1 ; then
        curl -fL --retry 3 -o "$ZIP" "$DIST_URL" || die "ERROR: Gradle download failed. Check your network/proxy."
    elif command -v wget >/dev/null 2>&1 ; then
        wget -O "$ZIP" "$DIST_URL" || die "ERROR: Gradle download failed. Check your network/proxy."
    else
        die "ERROR: neither curl nor wget is available to download Gradle. Install Gradle manually."
    fi

    if command -v unzip >/dev/null 2>&1 ; then
        unzip -q -o "$ZIP" -d "$DIST_HOME"
    else
        "$JAVACMD" -version >/dev/null 2>&1
        command -v jar >/dev/null 2>&1 || die "ERROR: 'unzip' not found. Install unzip and retry."
        (cd "$DIST_HOME" && jar xf "$ZIP")
    fi
    rm -f "$ZIP"
    chmod +x "$GRADLE_BIN" 2>/dev/null || true
    [ -x "$GRADLE_BIN" ] || die "ERROR: Gradle bootstrap failed (missing $GRADLE_BIN)."
    echo "[Pydrud] Gradle $GRADLE_VER ready."
fi

exec "$GRADLE_BIN" "$@"
