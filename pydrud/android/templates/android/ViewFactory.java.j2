package {{ package }};
import android.graphics.Color;
import android.graphics.Typeface;
import android.graphics.drawable.GradientDrawable;
import android.util.Log;
import android.view.Gravity;
import android.view.View;
import android.view.ViewGroup;
import android.widget.*;
import org.json.JSONArray;
import org.json.JSONObject;
import org.json.JSONException;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

/**
 * ViewFactory — converts Pydrud JSON widget trees into native Android Views.
 *
 * It is now a thin orchestrator: the heavy lifting lives in the collaborator
 * classes {@link BuiltinViews}, {@link ViewStyler}, {@link LayoutEngine},
 * {@link TreePatcher}, {@link EventBinder}, {@link NativeViewFactory},
 * {@link ViewAnimator} and {@link ImageLoader}. ViewFactory owns the shared
 * view/ node maps and wires the collaborators together in its constructor.
 */
public class ViewFactory {

static final String TAG = "PydrudViewFactory";
final {{ app_name }}Activity activity;
final Map<String, View> viewMap = new HashMap<>();
final Map<String, String> parentMap = new HashMap<>();
final Map<String, JSONObject> nodeMap = new HashMap<>();
final Map<String, ViewElement> elementMap = new HashMap<>();
final Map<View, int[]> safeAreaViews = new java.util.WeakHashMap<>();
final Map<View, Integer> linearSpacing = new java.util.WeakHashMap<>();
final WidgetRegistry registry = new WidgetRegistry();
final MaterialViews material;
final AdvancedViews advanced;
final GestureBinder gestures;
EventDispatcher eventDispatcher;
    final ImageLoader mImageLoader;
    final ViewStyler mStyler;
    final LayoutEngine mLayout;
    final TreePatcher mPatcher;
    final EventBinder mEvents;
    final NativeViewFactory mNativeViews;
    final ViewAnimator mAnimator;
    final BuiltinViews mBuiltin;

    static final class ViewElement {
        final String key;
        final String type;
        final View view;
        long confirmedRevision;
        ViewElement(String key, String type, View view) {
            this.key = key;
            this.type = type;
            this.view = view;
        }
    }

    public ViewFactory({{ app_name }}Activity activity) {
        this.activity = activity;
        this.material = new MaterialViews(activity, this);
        this.advanced = new AdvancedViews(activity, null);
        this.gestures = new GestureBinder(activity);
    
        this.mImageLoader = new ImageLoader(this);
        this.mStyler = new ViewStyler(this);
        this.mLayout = new LayoutEngine(this);
        this.mPatcher = new TreePatcher(this);
        this.mEvents = new EventBinder(this);
        this.mNativeViews = new NativeViewFactory(this);
        this.mAnimator = new ViewAnimator(this);
        this.mBuiltin = new BuiltinViews(this);
    }

    public void applyPatch(JSONObject patch) throws JSONException {
        mPatcher.applyPatch(patch);
    }

    public void refreshInsets() {
        mLayout.refreshInsets();
    }

    public void setEventDispatcher(EventDispatcher d) {
        this.eventDispatcher = d;
        material.setEventDispatcher(d);
        advanced.setEventDispatcher(d);
        gestures.setEventDispatcher(d);
    }

    public android.graphics.drawable.Drawable icon(String name, int color, int sizePx) {
        return PydrudIcons.drawable(name, color, sizePx);
    }

    public void loadImage(ImageView view, String src) {
        mImageLoader.loadImageInto(view, src == null ? "" : src);
    }

    public void registerWidget(String type, ViewCreator creator) {
        registry.register(type, creator);
    }

    public View getView(String key) { return viewMap.get(key); }

    public JSONObject getNode(String key) { return nodeMap.get(key); }

    public void buildTree(JSONObject tree, ViewGroup root) {
        if (eventDispatcher != null) eventDispatcher.clear();
        // A full snapshot is authoritative, but existing keyed native Views
        // remain available for adapters which can safely reuse them.
        root.removeAllViews();
        viewMap.clear();
        parentMap.clear();
        nodeMap.clear();
        View v = mBuiltin.createView(tree);
        if (v != null) {
            FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(
                FrameLayout.LayoutParams.MATCH_PARENT,
                FrameLayout.LayoutParams.MATCH_PARENT);
            root.addView(v, lp);
            mStyler.applySize(v, tree.optJSONObject("style"));
            mPatcher.indexParents(tree);
        }
    }

    public void clear() {
        viewMap.clear();
        parentMap.clear();
        nodeMap.clear();
        elementMap.clear();
        safeAreaViews.clear();
    }

    JSONObject props(JSONObject json) {
        JSONObject p = json.optJSONObject("props");
        return p == null ? new JSONObject() : p;
    }

}
