package {{ package }};

import android.app.Notification;
import android.app.NotificationChannel;
import android.app.NotificationManager;
import android.app.PendingIntent;
import android.app.Service;
import android.content.Intent;
import android.os.Build;
import android.os.IBinder;

/**
 * PydrudForegroundService — keeps the app (and its Python interpreter)
 * alive with a sticky notification while a long task runs.
 *
 * Started and updated from Python::
 *
 *     page.background.start_service(title="Syncing", message="0 of 120")
 *     page.background.update_service(message="40 of 120", progress=33)
 *     page.background.stop_service()
 */
public class PydrudForegroundService extends Service {

    private static final String CHANNEL_ID = "pydrud_service";
    private static final int NOTIFICATION_ID = 4711;

    @Override
    public int onStartCommand(Intent intent, int flags, int startId) {
        String action = intent == null ? "start" : intent.getAction();
        if ("stop".equals(action)) {
            stopForeground(true);
            stopSelf();
            return START_NOT_STICKY;
        }

        String title = intent == null ? "Running"
            : intent.getStringExtra("title");
        String message = intent == null ? "" : intent.getStringExtra("message");
        int progress = intent == null ? -1 : intent.getIntExtra("progress", -1);
        boolean ongoing = intent == null || intent.getBooleanExtra("ongoing", true);

        createChannel();
        Notification notification = build(
            title == null || title.isEmpty() ? "Running" : title,
            message == null ? "" : message, progress, ongoing);
        startForeground(NOTIFICATION_ID, notification);
        return START_STICKY;
    }

    private void createChannel() {
        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return;
        NotificationManager manager = getSystemService(NotificationManager.class);
        if (manager == null) return;
        NotificationChannel channel = new NotificationChannel(CHANNEL_ID,
            "Background work", NotificationManager.IMPORTANCE_LOW);
        channel.setShowBadge(false);
        manager.createNotificationChannel(channel);
    }

    private Notification build(String title, String message, int progress,
                               boolean ongoing) {
        Intent launch = new Intent(this, {{ app_name }}Activity.class);
        PendingIntent pending = PendingIntent.getActivity(this, 0, launch,
            PendingIntent.FLAG_UPDATE_CURRENT
            | (Build.VERSION.SDK_INT >= 23 ? PendingIntent.FLAG_IMMUTABLE : 0));

        Notification.Builder builder = Build.VERSION.SDK_INT >= Build.VERSION_CODES.O
            ? new Notification.Builder(this, CHANNEL_ID)
            : new Notification.Builder(this);
        builder.setContentTitle(title)
               .setContentText(message)
               .setSmallIcon(android.R.drawable.stat_notify_sync)
               .setContentIntent(pending)
               .setOngoing(ongoing);
        if (progress >= 0) {
            builder.setProgress(100, Math.min(100, progress), false);
        }
        return builder.build();
    }

    @Override
    public IBinder onBind(Intent intent) {
        return null;
    }
}
