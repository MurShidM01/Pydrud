/**
 * AdvancedViews — the v1.3 widgets that need a purpose-built native view:
 * {@code Canvas}, {@code RichText}, {@code Markdown}, {@code MapView},
 * {@code ReorderableList} and the virtualised {@code InfiniteList}.
 *
 * Every builder returns a plain {@link View}; {@link ViewFactory} owns
 * layout params, styling and event wiring as usual.
 */
public class AdvancedViews {

    private final {{ app_name }}Activity activity;
    private EventDispatcher events;

    public AdvancedViews({{ app_name }}Activity activity, EventDispatcher events) {
        this.activity = activity;
        this.events = events;
    }

    /** Late-bind the dispatcher: {@link ViewFactory} is built before it exists. */
    public void setEventDispatcher(EventDispatcher d) { this.events = d; }

    private int dp(float value) {
        return (int) (value * activity.getResources().getDisplayMetrics().density);
    }

    private static int color(String value, int fallback) {
        if (value == null || value.isEmpty()) return fallback;
        try {
            return Color.parseColor(value);
        } catch (Exception e) {
            return fallback;
        }
    }

    // ── Canvas ───────────────────────────────────────────────────────────

    /** A view that replays the drawing commands recorded in Python. */
    public static class PydrudCanvas extends View {
        private JSONArray ops = new JSONArray();
        private boolean fractional = true;
        private final Paint paint = new Paint();
        private final TextPaint textPaint = new TextPaint();
        private final float density;

        public PydrudCanvas(Context context) {
            super(context);
            density = context.getResources().getDisplayMetrics().density;
            paint.setAntiAlias(true);
            textPaint.setAntiAlias(true);
        }

        public void setOps(JSONArray ops, boolean fractional) {
            this.ops = ops == null ? new JSONArray() : ops;
            this.fractional = fractional;
            invalidate();
        }

        private float x(double value) {
            return (float) (fractional ? value * getWidth() : value * density);
        }

        private float y(double value) {
            return (float) (fractional ? value * getHeight() : value * density);
        }

        private float size(double value) {
            float base = fractional ? Math.min(getWidth(), getHeight()) : density;
            return (float) (value * base);
        }

        private void applyPaint(JSONObject spec) {
            paint.reset();
            paint.setAntiAlias(true);
            if (spec == null) return;
            int argb = color(spec.optString("color", ""), PydrudTheme.primary);
            double alpha = spec.optDouble("alpha", 1.0);
            paint.setColor(argb);
            paint.setAlpha((int) (Color.alpha(argb) * alpha));
            paint.setStyle(spec.optBoolean("fill", false)
                ? Paint.Style.FILL : Paint.Style.STROKE);
            paint.setStrokeWidth((float) spec.optDouble("width", 2.0) * density);
            String cap = spec.optString("cap", "butt");
            if ("round".equals(cap)) paint.setStrokeCap(Paint.Cap.ROUND);
            else if ("square".equals(cap)) paint.setStrokeCap(Paint.Cap.SQUARE);
            String join = spec.optString("join", "miter");
            if ("round".equals(join)) paint.setStrokeJoin(Paint.Join.ROUND);
            else if ("bevel".equals(join)) paint.setStrokeJoin(Paint.Join.BEVEL);
            JSONArray dash = spec.optJSONArray("dash");
            if (dash != null && dash.length() >= 2) {
                float[] pattern = new float[dash.length()];
                for (int i = 0; i < dash.length(); i++) {
                    pattern[i] = (float) dash.optDouble(i, 4) * density;
                }
                paint.setPathEffect(new DashPathEffect(pattern, 0));
            }
            double shadow = spec.optDouble("shadow", 0);
            if (shadow > 0) {
                paint.setShadowLayer((float) shadow * density, 0,
                    2 * density, Color.argb(60, 0, 0, 0));
            }
        }

        @Override
        protected void onDraw(Canvas canvas) {
            super.onDraw(canvas);
            for (int i = 0; i < ops.length(); i++) {
                JSONObject op = ops.optJSONObject(i);
                if (op == null) continue;
                draw(canvas, op);
            }
        }

        private void draw(Canvas canvas, JSONObject op) {
            String kind = op.optString("op", "");
            JSONObject spec = op.optJSONObject("paint");
            switch (kind) {
                case "line":
                    applyPaint(spec);
                    canvas.drawLine(x(op.optDouble("x1")), y(op.optDouble("y1")),
                                    x(op.optDouble("x2")), y(op.optDouble("y2")), paint);
                    break;
                case "rect": {
                    applyPaint(spec);
                    RectF rect = new RectF(x(op.optDouble("x")), y(op.optDouble("y")),
                        x(op.optDouble("x") + op.optDouble("w")),
                        y(op.optDouble("y") + op.optDouble("h")));
                    float radius = size(op.optDouble("radius", 0));
                    if (radius > 0) canvas.drawRoundRect(rect, radius, radius, paint);
                    else canvas.drawRect(rect, paint);
                    break;
                }
                case "circle":
                    applyPaint(spec);
                    canvas.drawCircle(x(op.optDouble("x")), y(op.optDouble("y")),
                                      size(op.optDouble("r")), paint);
                    break;
                case "oval": {
                    applyPaint(spec);
                    RectF rect = new RectF(x(op.optDouble("x")), y(op.optDouble("y")),
                        x(op.optDouble("x") + op.optDouble("w")),
                        y(op.optDouble("y") + op.optDouble("h")));
                    canvas.drawOval(rect, paint);
                    break;
                }
                case "arc": {
                    applyPaint(spec);
                    float r = size(op.optDouble("r"));
                    RectF bounds = new RectF(x(op.optDouble("x")) - r,
                        y(op.optDouble("y")) - r, x(op.optDouble("x")) + r,
                        y(op.optDouble("y")) + r);
                    canvas.drawArc(bounds, (float) op.optDouble("start", 0),
                        (float) op.optDouble("sweep", 90),
                        op.optBoolean("pie", false), paint);
                    break;
                }
                case "path": {
                    applyPaint(spec);
                    canvas.drawPath(buildPath(op.optJSONArray("ops")), paint);
                    break;
                }
                case "text": {
                    textPaint.setColor(color(op.optString("color", ""),
                                             PydrudTheme.onSurface));
                    textPaint.setTextSize((float) op.optDouble("size", 14) * density);
                    textPaint.setFakeBoldText(op.optInt("weight", 400) >= 600);
                    String align = op.optString("align", "left");
                    textPaint.setTextAlign("center".equals(align) ? Paint.Align.CENTER
                        : "right".equals(align) ? Paint.Align.RIGHT : Paint.Align.LEFT);
                    canvas.drawText(op.optString("value", ""),
                        x(op.optDouble("x")), y(op.optDouble("y")), textPaint);
                    break;
                }
                case "save":     canvas.save(); break;
                case "restore":  canvas.restore(); break;
                case "translate":
                    canvas.translate(x(op.optDouble("dx")), y(op.optDouble("dy")));
                    break;
                case "rotate":
                    canvas.rotate((float) op.optDouble("deg"),
                        x(op.optDouble("x", 0.5)), y(op.optDouble("y", 0.5)));
                    break;
                case "scale":
                    canvas.scale((float) op.optDouble("sx", 1),
                                 (float) op.optDouble("sy", 1));
                    break;
                case "clip":
                    canvas.clipRect(x(op.optDouble("x")), y(op.optDouble("y")),
                        x(op.optDouble("x") + op.optDouble("w")),
                        y(op.optDouble("y") + op.optDouble("h")));
                    break;
                default:
                    break;
            }
        }

        private Path buildPath(JSONArray segments) {
            Path path = new Path();
            for (int i = 0; segments != null && i < segments.length(); i++) {
                JSONObject segment = segments.optJSONObject(i);
                if (segment == null) continue;
                switch (segment.optString("op", "")) {
                    case "move":
                        path.moveTo(x(segment.optDouble("x")), y(segment.optDouble("y")));
                        break;
                    case "line":
                        path.lineTo(x(segment.optDouble("x")), y(segment.optDouble("y")));
                        break;
                    case "quad":
                        path.quadTo(x(segment.optDouble("cx")), y(segment.optDouble("cy")),
                                    x(segment.optDouble("x")), y(segment.optDouble("y")));
                        break;
                    case "cubic":
                        path.cubicTo(x(segment.optDouble("c1x")), y(segment.optDouble("c1y")),
                                     x(segment.optDouble("c2x")), y(segment.optDouble("c2y")),
                                     x(segment.optDouble("x")), y(segment.optDouble("y")));
                        break;
                    case "close":
                        path.close();
                        break;
                    default:
                        break;
                }
            }
            return path;
        }
    }

    public View createCanvas(JSONObject props) {
        PydrudCanvas view = new PydrudCanvas(activity);
        view.setOps(props.optJSONArray("ops"),
                    !"px".equals(props.optString("units", "fraction")));
        return view;
    }

    public void updateCanvas(View view, JSONObject props) {
        if (view instanceof PydrudCanvas) {
            ((PydrudCanvas) view).setOps(props.optJSONArray("ops"),
                !"px".equals(props.optString("units", "fraction")));
        }
    }

    // ── RichText & Markdown ──────────────────────────────────────────────

    private void appendSpans(SpannableStringBuilder builder, JSONArray spans,
                             final String key) {
        for (int i = 0; spans != null && i < spans.length(); i++) {
            JSONObject span = spans.optJSONObject(i);
            if (span == null) continue;
            String text = span.optString("text", "");
            int start = builder.length();
            builder.append(text);
            int end = builder.length();
            int flag = Spannable.SPAN_EXCLUSIVE_EXCLUSIVE;

            if (span.has("color")) {
                builder.setSpan(new ForegroundColorSpan(
                    color(span.optString("color"), Color.DKGRAY)), start, end, flag);
            }
            if (span.has("bg")) {
                builder.setSpan(new BackgroundColorSpan(
                    color(span.optString("bg"), Color.TRANSPARENT)), start, end, flag);
            }
            if (span.optInt("weight", 400) >= 600) {
                builder.setSpan(new StyleSpan(Typeface.BOLD), start, end, flag);
            }
            if (span.optBoolean("italic", false)) {
                builder.setSpan(new StyleSpan(Typeface.ITALIC), start, end, flag);
            }
            if (span.optBoolean("underline", false)) {
                builder.setSpan(new UnderlineSpan(), start, end, flag);
            }
            if (span.optBoolean("strike", false)) {
                builder.setSpan(new StrikethroughSpan(), start, end, flag);
            }
            if (span.optBoolean("mono", false)) {
                builder.setSpan(new TypefaceSpan("monospace"), start, end, flag);
            }
            if (span.has("size")) {
                builder.setSpan(new RelativeSizeSpan(
                    (float) span.optDouble("size", 14) / 14f), start, end, flag);
            }
            final String link = span.optString("link", "");
            if (!link.isEmpty()) {
                builder.setSpan(new ClickableSpan() {
                    @Override public void onClick(View widget) {
                        JSONObject data = new JSONObject();
                        try { data.put("link", link); } catch (Exception ignored) { }
                        events.dispatch("link", key, data);
                    }
                }, start, end, flag);
            }
        }
    }

    public View createRichText(JSONObject props, String key) {
        TextView view = new TextView(activity);
        applyRichText(view, props, key);
        return view;
    }

    public void applyRichText(TextView view, JSONObject props, String key) {
        SpannableStringBuilder builder = new SpannableStringBuilder();
        appendSpans(builder, props.optJSONArray("spans"), key);
        view.setText(builder);
        view.setTextSize((float) props.optDouble("size", 14));
        view.setTextColor(color(props.optString("color", ""), PydrudTheme.onSurface));
        if (props.has("maxLines")) view.setMaxLines(props.optInt("maxLines"));
        view.setTextIsSelectable(props.optBoolean("selectable", false));
        view.setMovementMethod(LinkMovementMethod.getInstance());
        String align = props.optString("align", "left");
        view.setGravity("center".equals(align) ? Gravity.CENTER_HORIZONTAL
            : "right".equals(align) ? Gravity.END : Gravity.START);
    }

    public View createMarkdown(JSONObject props, String key) {
        LinearLayout column = new LinearLayout(activity);
        column.setOrientation(LinearLayout.VERTICAL);
        applyMarkdown(column, props, key);
        return column;
    }

    public void applyMarkdown(LinearLayout column, JSONObject props, String key) {
        column.removeAllViews();
        JSONArray blocks = props.optJSONArray("blocks");
        float base = (float) props.optDouble("size", 14);
        for (int i = 0; blocks != null && i < blocks.length(); i++) {
            JSONObject block = blocks.optJSONObject(i);
            if (block == null) continue;
            String kind = block.optString("kind", "paragraph");
            if ("rule".equals(kind)) {
                View rule = new View(activity);
                LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(
                    ViewGroup.LayoutParams.MATCH_PARENT, dp(1));
                params.topMargin = dp(8);
                params.bottomMargin = dp(8);
                rule.setLayoutParams(params);
                rule.setBackgroundColor(PydrudTheme.outline);
                column.addView(rule);
                continue;
            }

            TextView text = new TextView(activity);
            text.setTextColor(color(props.optString("color", ""), PydrudTheme.onSurface));
            SpannableStringBuilder builder = new SpannableStringBuilder();

            if ("code".equals(kind)) {
                builder.append(block.optString("text", ""));
                text.setTypeface(Typeface.MONOSPACE);
                text.setBackgroundColor(color(props.optString("codeBg", ""),
                                              PydrudTheme.surfaceVariant));
                text.setPadding(dp(12), dp(10), dp(12), dp(10));
                text.setTextSize(base - 1);
            } else if ("heading".equals(kind)) {
                appendSpans(builder, block.optJSONArray("spans"), key);
                int level = block.optInt("level", 1);
                text.setTextSize(base + Math.max(0, 8 - (level - 1) * 2));
                text.setTypeface(Typeface.DEFAULT_BOLD);
            } else if ("quote".equals(kind)) {
                appendSpans(builder, block.optJSONArray("spans"), key);
                text.setPadding(dp(12), dp(4), dp(4), dp(4));
                text.setTextSize(base);
                text.setTypeface(Typeface.defaultFromStyle(Typeface.ITALIC));
            } else if ("list".equals(kind)) {
                JSONArray items = block.optJSONArray("items");
                boolean ordered = block.optBoolean("ordered", false);
                for (int j = 0; items != null && j < items.length(); j++) {
                    JSONObject item = items.optJSONObject(j);
                    if (item == null) continue;
                    String bullet = ordered ? (j + 1) + ". " : "•  ";
                    if (!item.isNull("checked")) {
                        bullet = item.optBoolean("checked") ? "☑  " : "☐  ";
                    }
                    builder.append(bullet);
                    appendSpans(builder, item.optJSONArray("spans"), key);
                    if (j < items.length() - 1) builder.append("\n");
                }
                text.setTextSize(base);
            } else {
                appendSpans(builder, block.optJSONArray("spans"), key);
                text.setTextSize(base);
            }

            text.setText(builder);
            text.setMovementMethod(LinkMovementMethod.getInstance());
            text.setTextIsSelectable(props.optBoolean("selectable", true));
            LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.WRAP_CONTENT);
            params.bottomMargin = dp(8);
            text.setLayoutParams(params);
            column.addView(text);
        }
    }

    // ── MapView ──────────────────────────────────────────────────────────

    /**
     * A Leaflet/OpenStreetMap map inside a WebView — no API key, no Play
     * Services, and markers/taps bridge back as normal Pydrud events.
     */
    public View createMap(JSONObject props, final String key) {
        WebView web = new WebView(activity);
        web.getSettings().setJavaScriptEnabled(true);
        web.getSettings().setDomStorageEnabled(true);
        web.setWebViewClient(new WebViewClient());
        web.addJavascriptInterface(new MapBridge(key), "PydrudMap");
        web.loadDataWithBaseURL("https://tile.openstreetmap.org/",
            mapHtml(props), "text/html", "utf-8", null);
        return web;
    }

    private String mapHtml(JSONObject props) {
        double lat = props.optDouble("lat", 0);
        double lon = props.optDouble("lon", 0);
        double zoom = props.optDouble("zoom", 13);
        JSONArray markers = props.optJSONArray("markers");
        StringBuilder pins = new StringBuilder();
        for (int i = 0; markers != null && i < markers.length(); i++) {
            JSONObject marker = markers.optJSONObject(i);
            if (marker == null) continue;
            pins.append("L.marker([").append(marker.optDouble("lat"))
                .append(",").append(marker.optDouble("lon"))
                .append("]).addTo(map).bindPopup(")
                .append(JSONObject.quote(marker.optString("title", "")))
                .append(").on('click',function(){PydrudMap.marker(")
                .append(JSONObject.quote(marker.optString("id", ""))).append(");});");
        }
        return "<!DOCTYPE html><html><head>"
            + "<meta name='viewport' content='width=device-width,initial-scale=1'>"
            + "<link rel='stylesheet' href='https://unpkg.com/leaflet/dist/leaflet.css'/>"
            + "<script src='https://unpkg.com/leaflet/dist/leaflet.js'></script>"
            + "<style>html,body,#m{height:100%;margin:0}</style></head>"
            + "<body><div id='m'></div><script>"
            + "var map=L.map('m').setView([" + lat + "," + lon + "]," + zoom + ");"
            + "L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',"
            + "{maxZoom:19,attribution:'© OpenStreetMap'}).addTo(map);"
            + pins
            + "map.on('click',function(e){PydrudMap.tap(e.latlng.lat,e.latlng.lng);});"
            + "map.on('moveend',function(){var c=map.getCenter();"
            + "PydrudMap.move(c.lat,c.lng,map.getZoom());});"
            + "</script></body></html>";
    }

    /** JavaScript → Python bridge for map interactions. */
    public class MapBridge {
        private final String key;

        MapBridge(String key) {
            this.key = key;
        }

        @android.webkit.JavascriptInterface
        public void tap(double lat, double lon) {
            JSONObject data = new JSONObject();
            try {
                data.put("lat", lat);
                data.put("lon", lon);
            } catch (Exception ignored) { }
            events.dispatch("tap", key, data);
        }

        @android.webkit.JavascriptInterface
        public void marker(String id) {
            JSONObject data = new JSONObject();
            try { data.put("id", id); } catch (Exception ignored) { }
            events.dispatch("marker", key, data);
        }

        @android.webkit.JavascriptInterface
        public void move(double lat, double lon, double zoom) {
            JSONObject data = new JSONObject();
            try {
                data.put("lat", lat);
                data.put("lon", lon);
                data.put("zoom", zoom);
            } catch (Exception ignored) { }
            events.dispatch("move", key, data);
        }
    }

    // ── Reorderable & infinite lists ─────────────────────────────────────

    /** Adapter over already-built child views (Pydrud owns the view tree). */
    public static class ViewAdapter extends RecyclerView.Adapter<ViewAdapter.Holder> {
        final List<View> views = new ArrayList<>();

        static class Holder extends RecyclerView.ViewHolder {
            final ViewGroup container;

            Holder(ViewGroup container) {
                super(container);
                this.container = container;
            }
        }

        @Override
        public Holder onCreateViewHolder(ViewGroup parent, int viewType) {
            LinearLayout wrapper = new LinearLayout(parent.getContext());
            wrapper.setOrientation(LinearLayout.VERTICAL);
            wrapper.setLayoutParams(new RecyclerView.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.WRAP_CONTENT));
            return new Holder(wrapper);
        }

        @Override
        public void onBindViewHolder(Holder holder, int position) {
            holder.container.removeAllViews();
            View child = views.get(position);
            if (child.getParent() instanceof ViewGroup) {
                ((ViewGroup) child.getParent()).removeView(child);
            }
            holder.container.addView(child);
        }

        @Override
        public int getItemCount() {
            return views.size();
        }

        public void setViews(List<View> replacement) {
            views.clear();
            views.addAll(replacement);
            notifyDataSetChanged();
        }

        public void move(int from, int to) {
            if (from < 0 || to < 0 || from >= views.size() || to >= views.size()) {
                return;
            }
            views.add(to, views.remove(from));
            notifyItemMoved(from, to);
        }
    }

    public RecyclerView createList(final String key, final JSONObject props,
                                   final boolean reorderable) {
        RecyclerView list = new RecyclerView(activity);
        list.setLayoutManager(new LinearLayoutManager(activity));
        final ViewAdapter adapter = new ViewAdapter();
        list.setAdapter(adapter);

        if (reorderable) {
            int swipeFlags = props.optBoolean("swipeToRemove", false)
                ? ItemTouchHelper.START | ItemTouchHelper.END : 0;
            ItemTouchHelper helper = new ItemTouchHelper(
                new ItemTouchHelper.SimpleCallback(
                    ItemTouchHelper.UP | ItemTouchHelper.DOWN, swipeFlags) {
                @Override
                public boolean onMove(RecyclerView view,
                                      RecyclerView.ViewHolder holder,
                                      RecyclerView.ViewHolder target) {
                    int from = holder.getAdapterPosition();
                    int to = target.getAdapterPosition();
                    adapter.move(from, to);
                    JSONObject data = new JSONObject();
                    try {
                        data.put("from", from);
                        data.put("to", to);
                    } catch (Exception ignored) { }
                    events.dispatch("reorder", key, data);
                    return true;
                }

                @Override
                public void onSwiped(RecyclerView.ViewHolder holder, int direction) {
                    JSONObject data = new JSONObject();
                    try { data.put("index", holder.getAdapterPosition()); }
                    catch (Exception ignored) { }
                    events.dispatch("remove", key, data);
                }
            });
            helper.attachToRecyclerView(list);
        } else {
            final int threshold = props.optInt("threshold", 5);
            list.addOnScrollListener(new RecyclerView.OnScrollListener() {
                private boolean requested = false;

                @Override
                public void onScrolled(RecyclerView view, int dx, int dy) {
                    LinearLayoutManager manager =
                        (LinearLayoutManager) view.getLayoutManager();
                    if (manager == null) return;
                    int last = manager.findLastVisibleItemPosition();
                    int total = manager.getItemCount();
                    if (last >= total - threshold) {
                        if (requested) return;
                        requested = true;
                        events.dispatch("load_more", key, new JSONObject());
                    } else {
                        requested = false;
                    }
                }
            });
        }
        return list;
    }

    /** Replace the rows of a list created by {@link #createList}. */
    public void setListViews(RecyclerView list, List<View> children) {
        RecyclerView.Adapter<?> adapter = list.getAdapter();
        if (adapter instanceof ViewAdapter) {
            ((ViewAdapter) adapter).setViews(children);
        }
    }
}
