    /** Validate the form, then open the authenticated preview session. */
    private void connectPreview(String uri, String host, String portText,
                                String session, String token) {
        if (uri.startsWith("pydrud://")) {
            try {
                android.net.Uri parsed = android.net.Uri.parse(uri);
                host = parsed.getQueryParameter("host");
                portText = parsed.getQueryParameter("port");
                session = parsed.getQueryParameter("session");
                token = parsed.getQueryParameter("token");
            } catch (Throwable t) {
                previewStatus.setText("That URI could not be parsed.");
                return;
            }
        }
        int port;
        try {
            port = Integer.parseInt(portText == null ? "" : portText.trim());
        } catch (NumberFormatException e) {
            port = -1;
        }
        if (host == null || host.isEmpty() || port < 1 || port > 65535
                || session == null || session.isEmpty()
                || token == null || token.isEmpty()) {
            previewStatus.setText(
                "Enter the connection URI or all four fields.");
            return;
        }
        previewConnectButton.setEnabled(false);
        previewStatus.setText("Connecting to " + host + ":" + port + " …");
        previewPrefs().edit()
            .putString("preview_host", host)
            .putString("preview_port", String.valueOf(port))
            .apply();
        PreviewClient.connect(host, port, session, token, this, this);
    }

    @Override
    public void onPreviewConnected(final java.net.Socket socket) {
        runOnUiThread(() -> {
            setContentView(rootView);
            bridge.serveExternalConnection(socket);
            // A deep link that launched the app waits until the host is
            // actually listening, so no link is ever dropped.
            flushDeepLink();
        });
    }

    @Override
    public void onPreviewError(final String message) {
        runOnUiThread(() -> {
            previewStatus.setText("Connection failed: " + message);
            previewConnectButton.setEnabled(true);
        });
    }

