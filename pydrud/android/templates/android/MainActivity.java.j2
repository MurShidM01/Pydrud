    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        WindowCompat.setDecorFitsSystemWindows(getWindow(), false);

        // Design tokens have to exist before the first view is built.
        PydrudTheme.init(this);

        rootView = new FrameLayout(this);
        rootView.setLayoutParams(new ViewGroup.LayoutParams(
            ViewGroup.LayoutParams.MATCH_PARENT,
            ViewGroup.LayoutParams.MATCH_PARENT));
        rootView.setBackgroundColor(PydrudTheme.background);
        setContentView(rootView);

        // Edge-to-edge with readable system bars, and no white flash while
        // Python boots.
        getWindow().setBackgroundDrawable(
            new android.graphics.drawable.ColorDrawable(PydrudTheme.background));
        applySystemBarAppearance();

        // Edge-to-edge: the window extends behind the system bars and the
        // widgets that touch an edge (app bar, bottom navigation) pad
        // themselves, so their surface continues under the bars instead of
        // leaving a grey strip. Side insets and the keyboard are handled
        // here because they affect every screen.
        ViewCompat.setOnApplyWindowInsetsListener(rootView, (v, windowInsets) -> {
            Insets bars = windowInsets.getInsets(WindowInsetsCompat.Type.systemBars()
                | WindowInsetsCompat.Type.displayCutout());
            Insets ime = windowInsets.getInsets(WindowInsetsCompat.Type.ime());
            PydrudTheme.setInsets(bars.left, bars.top, bars.right, bars.bottom);
            PydrudTheme.keyboardPx = Math.max(0, ime.bottom - bars.bottom);
            v.setPadding(bars.left, 0, bars.right, PydrudTheme.keyboardPx);
            if (viewFactory != null) viewFactory.refreshInsets();
            // Real safe-area values only exist once insets arrive — tell
            // Python so MediaQuery.safe_area() is accurate from frame one.
            scheduleMetrics("insets");
            return WindowInsetsCompat.CONSUMED;
        });

        // A deep link (myapp://route), launcher shortcut or notification tap
        // may have started us — forward it once Python is listening.
        // Modern back handling: Android 13+ predictive back gestures only
        // animate correctly when the press goes through the dispatcher;
        // overriding the deprecated onBackPressed() bypasses it entirely.
        backCallback = new OnBackPressedCallback(true) {
            @Override public void handleOnBackPressed() { requestPydrudBack(); }
        };
        getOnBackPressedDispatcher().addCallback(this, backCallback);

        handleDeepLinkIntent(getIntent());

        eventDispatcher = new EventDispatcher();
        viewFactory = new ViewFactory(this);
        viewFactory.setEventDispatcher(eventDispatcher);

        bridge = new BridgeService(this, rootView, viewFactory, eventDispatcher);
        eventDispatcher.setBridge(bridge);

        {% if standalone | default(true) %}
        new Thread(() -> {
            try {
                try {
                    java.io.File cacheDir = new java.io.File(getFilesDir(), "chaquopy/AssetFinder/app");
                    if (cacheDir.exists()) {
                        deleteDir(cacheDir);
                    }
                } catch (Throwable ignored) {}

                if (!Python.isStarted()) {
                    Python.start(new AndroidPlatform(this));
                }
                pythonStarted = true;
                Log.i(TAG, "Python interpreter started");

                // Start listening *before* Python tries to connect.
                bridge.start();
                bridge.awaitListening(5000);

                Log.i(TAG, "Invoking Python {{ python_entry | default('app.main') }}.start_app()");
                PyObject module = Python.getInstance().getModule("{{ python_entry | default('app.main') }}");
                module.callAttr("start_app");
            } catch (Throwable t) {
                Log.e(TAG, "Failed to start Python app", t);
                runOnUiThread(() -> showFatal(t));
            }
        }, "pydrud-python").start();
        {% else %}
        // Preview shell (`pydrud init android`): Python runs on the developer
        // machine under `pydrud dev`. Connect below; the renderer takes over
        // once the preview handshake succeeds.
        showPreviewConnect();
        {% endif %}
    }

    // ── Window metrics ────────────────────────────────────────────────────

    private final android.os.Handler metricsHandler =
        new android.os.Handler(android.os.Looper.getMainLooper());
    private Runnable pendingMetrics;

    /**
     * Push the new window metrics to Python, coalescing bursts.
     *
     * <p>A rotation produces a configuration change *and* several inset
     * callbacks; debouncing means Python re-renders once, with final
     * values, instead of three times mid-animation.
     */
    public void scheduleMetrics(final String reason) {
        if (bridge == null) return;
        if (pendingMetrics != null) metricsHandler.removeCallbacks(pendingMetrics);
        pendingMetrics = new Runnable() {
            @Override public void run() {
                pendingMetrics = null;
                if (bridge != null) bridge.sendMetrics(reason);
            }
        };
        metricsHandler.postDelayed(pendingMetrics, 48L);
    }

    @Override
    public void onConfigurationChanged(android.content.res.Configuration newConfig) {
        super.onConfigurationChanged(newConfig);
        // The activity is NOT recreated (see android:configChanges in the
        // manifest), so this is the only moment we learn about rotation,
        // split screen, a foldable opening or a font-size change.
        PydrudTheme.refreshMetrics(this);
        boolean night = (newConfig.uiMode
            & android.content.res.Configuration.UI_MODE_NIGHT_MASK)
            == android.content.res.Configuration.UI_MODE_NIGHT_YES;
        if (night != PydrudTheme.dark) {
            PydrudTheme.setNight(night);
            if (rootView != null) rootView.setBackgroundColor(PydrudTheme.background);
            applySystemBarAppearance();
        }
        if (rootView != null) rootView.requestApplyInsets();
        scheduleMetrics("configuration");
    }

    /** Render a readable error screen instead of a blank activity. */
    private void showFatal(Throwable t) {
        android.widget.TextView tv = new android.widget.TextView(this);
        tv.setText("Pydrud failed to start:\n\n" + t);
        PydrudTheme.applyTextDefaults(tv, 14f, 500, 0xFFB91C1C);
        tv.setPadding(PydrudTheme.dp(24), PydrudTheme.dp(24),
                      PydrudTheme.dp(24), PydrudTheme.dp(24));
        rootView.removeAllViews();
        rootView.addView(tv);
    }

    /**
     * Keep the status/navigation bar icons readable against the app
     * background, and let the content draw behind them.
     */
    public void applySystemBarAppearance() {
        try {
            getWindow().setStatusBarColor(android.graphics.Color.TRANSPARENT);
            getWindow().setNavigationBarColor(android.graphics.Color.TRANSPARENT);
            androidx.core.view.WindowInsetsControllerCompat controller =
                WindowCompat.getInsetsController(getWindow(), rootView);
            if (controller != null) {
                boolean lightBars = !PydrudTheme.dark;
                controller.setAppearanceLightStatusBars(lightBars);
                controller.setAppearanceLightNavigationBars(lightBars);
            }
        } catch (Throwable ignored) {}
    }

    /** Adopt a palette pushed from Python and repaint the shell. */
    public void applyTheme(final org.json.JSONObject scheme) {
        runOnUiThread(() -> {
            PydrudTheme.apply(scheme);
            if (rootView != null) rootView.setBackgroundColor(PydrudTheme.background);
            getWindow().setBackgroundDrawable(
                new android.graphics.drawable.ColorDrawable(PydrudTheme.background));
            applySystemBarAppearance();
        });
    }

    // ── Platform results ──────────────────────────────────────────────────

    @Override
    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
        super.onActivityResult(requestCode, resultCode, data);
        if (bridge != null && bridge.services().onActivityResult(
                requestCode, resultCode, data)) {
            return;
        }
        if (bridge != null && bridge.capture().onActivityResult(
                requestCode, resultCode, data)) {
            return;
        }
        if (bridge != null && bridge.connectivity().onActivityResult(
                requestCode, resultCode, data)) {
            return;
        }
        Log.d(TAG, "unhandled activity result " + requestCode);
    }

    @Override
    public void onRequestPermissionsResult(int requestCode, String[] permissions,
                                           int[] grantResults) {
        super.onRequestPermissionsResult(requestCode, permissions, grantResults);
        String cameraKey = pendingCameraPermissions.remove(requestCode);
        if (cameraKey != null) {
            boolean granted = grantResults.length > 0
                && grantResults[0] == android.content.pm.PackageManager.PERMISSION_GRANTED;
            if (granted) {
                startCamera(cameraKey, cameraFacings.get(cameraKey));
            } else {
                emitCameraError(cameraKey, "permission_denied",
                    "Camera permission was denied");
            }
            return;
        }
        if (bridge != null) {
            bridge.services().onPermissionResult(requestCode, permissions, grantResults);
        }
    }

    // ── UI commands from Python ───────────────────────────────────────────

    /** Slide the Drawer widget in or out. */
    public void setDrawerOpen(final boolean open, final String side) {
        runOnUiThread(() -> {
            android.view.View drawer = findDrawer(side);
            if (drawer == null) {
                Log.d(TAG, "no drawer declared for side " + side);
                return;
            }
            float width = drawer.getWidth() > 0 ? drawer.getWidth() : 600f;
            boolean fromEnd = "end".equals(side);
            if (open) {
                drawer.setTranslationX(fromEnd ? width : -width);
                drawer.setVisibility(android.view.View.VISIBLE);
                drawer.animate().translationX(0f).setDuration(220).start();
            } else {
                drawer.animate().translationX(fromEnd ? width : -width)
                      .setDuration(200)
                      .withEndAction(() -> drawer.setVisibility(android.view.View.GONE))
                      .start();
            }
            drawerOpen = open;
        });
    }

    public boolean isDrawerOpen() { return drawerOpen; }

    private android.view.View findDrawer(String side) {
        return findDrawerIn(rootView, side);
    }

    private android.view.View findDrawerIn(android.view.ViewGroup group, String side) {
        for (int i = 0; i < group.getChildCount(); i++) {
            android.view.View child = group.getChildAt(i);
            Object tag = child.getTag();
            if (tag instanceof String && viewFactory != null) {
                org.json.JSONObject node = viewFactory.getNode((String) tag);
                if (node != null && "Drawer".equals(node.optString("type", ""))) {
                    org.json.JSONObject props = node.optJSONObject("props");
                    String nodeSide = props != null
                        ? props.optString("side", "start") : "start";
                    if (nodeSide.equals(side)) return child;
                }
            }
            if (child instanceof android.view.ViewGroup) {
                android.view.View found =
                    findDrawerIn((android.view.ViewGroup) child, side);
                if (found != null) return found;
            }
        }
        return null;
    }

    /** Stop every SwipeRefreshLayout spinner in the tree. */
    public void endRefresh() {
        endRefreshIn(rootView);
    }

    private void endRefreshIn(android.view.ViewGroup group) {
        for (int i = 0; i < group.getChildCount(); i++) {
            android.view.View child = group.getChildAt(i);
            if (child instanceof androidx.swiperefreshlayout.widget.SwipeRefreshLayout) {
                ((androidx.swiperefreshlayout.widget.SwipeRefreshLayout) child)
                    .setRefreshing(false);
            }
            if (child instanceof android.view.ViewGroup) {
                endRefreshIn((android.view.ViewGroup) child);
            }
        }
    }

    public void setKeyboardVisible(final boolean show) {
        runOnUiThread(() -> {
            android.view.inputmethod.InputMethodManager imm =
                (android.view.inputmethod.InputMethodManager)
                    getSystemService(INPUT_METHOD_SERVICE);
            if (imm == null) return;
            android.view.View focused = getCurrentFocus();
            if (show) {
                if (focused != null) {
                    imm.showSoftInput(focused,
                        android.view.inputmethod.InputMethodManager.SHOW_IMPLICIT);
                }
            } else {
                android.view.View target = focused != null ? focused : rootView;
                imm.hideSoftInputFromWindow(target.getWindowToken(), 0);
            }
        });
    }

    public void setKeepAwake(final boolean enabled) {
        runOnUiThread(() -> {
            if (enabled) {
                getWindow().addFlags(
                    android.view.WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
            } else {
                getWindow().clearFlags(
                    android.view.WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
            }
        });
    }

    public void setOrientationLock(final String orientation) {
        runOnUiThread(() -> {
            switch (orientation) {
                case "portrait":
                    setRequestedOrientation(
                        android.content.pm.ActivityInfo.SCREEN_ORIENTATION_PORTRAIT);
                    break;
                case "landscape":
                    setRequestedOrientation(
                        android.content.pm.ActivityInfo.SCREEN_ORIENTATION_LANDSCAPE);
                    break;
                default:
                    setRequestedOrientation(
                        android.content.pm.ActivityInfo.SCREEN_ORIENTATION_UNSPECIFIED);
            }
        });
    }

    public void setFullscreen(final boolean enabled) {
        runOnUiThread(() -> {
            androidx.core.view.WindowInsetsControllerCompat controller =
                WindowCompat.getInsetsController(getWindow(), rootView);
            if (controller == null) return;
            if (enabled) {
                controller.hide(WindowInsetsCompat.Type.systemBars());
                controller.setSystemBarsBehavior(
                    androidx.core.view.WindowInsetsControllerCompat
                        .BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE);
            } else {
                controller.show(WindowInsetsCompat.Type.systemBars());
            }
        });
    }

    public void setThemeMode(final String mode) {
        runOnUiThread(() -> {
            switch (mode) {
                case "dark":
                    PydrudTheme.useDark();
                    applySystemBarAppearance();
                    androidx.appcompat.app.AppCompatDelegate.setDefaultNightMode(
                        androidx.appcompat.app.AppCompatDelegate.MODE_NIGHT_YES);
                    break;
                case "light":
                    PydrudTheme.useLight();
                    applySystemBarAppearance();
                    androidx.appcompat.app.AppCompatDelegate.setDefaultNightMode(
                        androidx.appcompat.app.AppCompatDelegate.MODE_NIGHT_NO);
                    break;
                default:
                    androidx.appcompat.app.AppCompatDelegate.setDefaultNightMode(
                        androidx.appcompat.app.AppCompatDelegate
                            .MODE_NIGHT_FOLLOW_SYSTEM);
            }
        });
    }

    // ── Back button ───────────────────────────────────────────────────────
    //
    // No deprecated onBackPressed() override here: every press arrives via
    // the OnBackPressedDispatcher callback registered in onCreate, so the
    // Android 13+ predictive back gesture animates and stays interceptable.

    private OnBackPressedCallback backCallback;

    private void requestPydrudBack() {
        // Ask Python first: the Router may want to pop a screen. Only fall
        // back to the default behaviour if Python does not answer in time
        // or reports that it did not handle the press.
        if (bridge == null || !bridge.isConnected()) {
            defaultBack();
            return;
        }
        if (awaitingBackResult) return;

        awaitingBackResult = true;
        pendingBack = () -> {
            if (awaitingBackResult) {
                awaitingBackResult = false;
                defaultBack();
            }
        };
        rootView.postDelayed(pendingBack, BACK_TIMEOUT_MS);
        bridge.sendEvent("back", "");
    }

    /** Called by BridgeService when Python answers the back event. */
    public void onBackResult(boolean handled) {
        runOnUiThread(() -> {
            awaitingBackResult = false;
            if (pendingBack != null) {
                rootView.removeCallbacks(pendingBack);
                pendingBack = null;
            }
            if (!handled) defaultBack();
        });
    }

    private void defaultBack() {
        // Run the dispatcher's default action (finish + system animation)
        // without re-entering our own callback.
        if (backCallback != null) backCallback.setEnabled(false);
        getOnBackPressedDispatcher().onBackPressed();
        if (backCallback != null) backCallback.setEnabled(true);
    }

    // ── Soft keyboard ─────────────────────────────────────────────────────

    /**
     * Tap-outside-to-dismiss: when a touch lands outside the focused text
     * field, the keyboard hides and the field loses focus — so users never
     * have to hunt for the hardware/system back button to close it.
     */
    @Override
    public boolean dispatchTouchEvent(android.view.MotionEvent event) {
        if (event.getAction() == android.view.MotionEvent.ACTION_DOWN) {
            android.view.View focused = getCurrentFocus();
            if (focused instanceof android.widget.EditText) {
                android.graphics.Rect bounds = new android.graphics.Rect();
                focused.getGlobalVisibleRect(bounds);
                if (!bounds.contains((int) event.getRawX(), (int) event.getRawY())) {
                    hideKeyboard(focused);
                }
            }
        }
        return super.dispatchTouchEvent(event);
    }

    /** Hide the soft keyboard and clear focus from a text field. */
    public void hideKeyboard(android.view.View focused) {
        android.view.inputmethod.InputMethodManager imm =
            (android.view.inputmethod.InputMethodManager)
                getSystemService(INPUT_METHOD_SERVICE);
        if (imm != null) imm.hideSoftInputFromWindow(focused.getWindowToken(), 0);
        focused.clearFocus();
    }

