    /** One labelled input row inside the connect form. */
    private android.widget.EditText previewField(
            android.widget.LinearLayout form, String hint, String value) {
        android.widget.EditText field = new android.widget.EditText(this);
        field.setHint(hint);
        field.setText(value);
        field.setSingleLine(true);
        PydrudTheme.applyTextDefaults(field, 15f, 400, PydrudTheme.onSurface);
