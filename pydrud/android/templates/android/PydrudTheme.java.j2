    /**
     * Resolve a corner radius, honouring the "full" sentinel.
     *
     * Material 3's ``full`` shape is half the shortest side — a pill for a
     * button, a circle for a square. GradientDrawable has no percentage
     * mode, so anything at or above the sentinel resolves to height / 2.
     */
    public static float resolvedCorner(float radiusPx, float heightPx) {
        return radiusPx >= cornerFull
            ? Math.max(0f, heightPx / 2f)
            : radiusPx;
    }

