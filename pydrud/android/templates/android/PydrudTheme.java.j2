    // ── typography ───────────────────────────────────────────────────────

    // The type ramp is a view onto the tokens, so Theme.configure(
    // text_title=22) in Python moves every title on the device.
    public static float display()  { return textDisplay * 1.3f; }
    public static float headline() { return textHeadline; }
    public static float title()    { return textTitle; }
    public static float subtitle() { return textSubtitle; }
    public static float body()     { return textBody; }
    public static float label()    { return textLabel; }
    public static float caption()  { return textCaption; }

    /** Real font weights on API 28+, graceful family fallback below. */
    public static Typeface typeface(int weight, boolean italic) {
        if (fontFamily != null && !fontFamily.isEmpty()) {
            return typeface(fontFamily, weight, italic);
        }
        try {
            if (Build.VERSION.SDK_INT >= 28) {
                int w = Math.max(100, Math.min(900, weight));
                return Typeface.create(Typeface.SANS_SERIF, w, italic);
            }
        } catch (Throwable ignored) {}
        // Snapped against the M3 weight roles rather than literals, so an app
        // that retunes weight_medium changes the whole scale with it.
        String family = "sans-serif";
        if (weight >= weightBold + 100) family = "sans-serif-black";
        else if (weight >= weightMedium) family = "sans-serif-medium";
        else if (weight <= 300) family = "sans-serif-light";
        return Typeface.create(family, italic ? Typeface.ITALIC : Typeface.NORMAL);
    }

    public static Typeface typeface(String familyName, int weight, boolean italic) {
        if (familyName == null || familyName.isEmpty()) return typeface(weight, italic);
        try {
            if (Build.VERSION.SDK_INT >= 28) {
                return Typeface.create(Typeface.create(familyName, Typeface.NORMAL),
                                       Math.max(100, Math.min(900, weight)), italic);
            }
        } catch (Throwable ignored) {}
        int style = Typeface.NORMAL;
        if (weight >= weightBold && italic) style = Typeface.BOLD_ITALIC;
        else if (weight >= weightBold) style = Typeface.BOLD;
        else if (italic) style = Typeface.ITALIC;
        return Typeface.create(familyName, style);
    }

    /** Tight, readable text metrics — the single biggest visual upgrade. */
    public static void applyTextDefaults(TextView tv, float sizeSp, int weight, int color) {
        if (tv == null) return;
        sizeSp = snapTextSize(sizeSp);
        tv.setTextSize(android.util.TypedValue.COMPLEX_UNIT_SP,
                       scaledSp(sizeSp * fontScaleToken));
        tv.setTextColor(color);
        tv.setTypeface(typeface(weight, false));
        tv.setIncludeFontPadding(false);
        tv.setLineSpacing(0f, sizeSp >= textHeadline ? lineHeight * 0.82f : lineHeight);
        if (weight == 0) tv.setTypeface(typeface((int) weightRegular, false));
        tv.setLetterSpacing(letterSpacingFor(sizeSp, weight));
    }

    /**
     * The duration a transition uses when a widget does not name one.
     *
     * M3 calls this "medium 2"; it is published as ``duration_normal``.
     */
    public static long defaultDurationMs() {
        return (long) durationNormal;
    }

    /** Large text tracks tighter, small caps-ish labels track wider. */
    public static float letterSpacingFor(float sizeSp, int weight) {
        if (letterSpacingToken != 0f) return letterSpacingToken;
        if (sizeSp >= 32) return -0.02f;
        if (sizeSp >= 20) return -0.01f;
        if (sizeSp <= 12) return 0.02f;
        return weight >= 600 ? 0.005f : 0.0f;
    }

    // ── widget recipes ───────────────────────────────────────────────────

    /** Minimum comfortable tap target (Material + WCAG): 48dp. */
    public static int touchTarget() { return adaptive(touchTargetDp); }

    /** Grow a view's hit rect to the minimum tap target. */
    public static void expandTouch(final View view, final int minPx) {
        if (view == null) return;
        final View parent = (view.getParent() instanceof View) ? (View) view.getParent() : null;
        if (parent == null) return;
        parent.post(new Runnable() {
            @Override public void run() {
                try {
                    android.graphics.Rect r = new android.graphics.Rect();
                    view.getHitRect(r);
                    int dw = Math.max(0, (minPx - r.width()) / 2);
                    int dh = Math.max(0, (minPx - r.height()) / 2);
                    if (dw == 0 && dh == 0) return;
                    r.inset(-dw, -dh);
                    parent.setTouchDelegate(new android.view.TouchDelegate(r, view));
                } catch (Throwable ignored) {}
            }
        });
    }

    /** Button background: fill + pressed/disabled states + ripple. */
    public static Drawable buttonBackground(int fill, float radiusPx, boolean enabled) {
        if (!enabled) return shape(disabledBg, radiusPx);
        StateListDrawable states = new StateListDrawable();
        states.addState(new int[]{-android.R.attr.state_enabled}, shape(disabledBg, radiusPx));
        states.addState(new int[]{}, shape(fill, radiusPx));
        return ripple(states, rippleOn(fill), radiusPx);
    }

    /** Outlined/text button background: transparent fill, tinted ripple. */
    public static Drawable outlineBackground(int strokeColor, float radiusPx,
                                             int strokePx, int rippleColor) {
        GradientDrawable base = shape(Color.TRANSPARENT, radiusPx, strokePx, strokeColor);
        return ripple(base, rippleColor, radiusPx);
    }

    /** Input background that reacts to focus, like a Flutter TextField. */
    public static Drawable inputBackground(int fill, int focusedFill, float radiusPx,
                                           int idleStroke, int focusStroke, int strokePx) {
        StateListDrawable states = new StateListDrawable();
        states.addState(new int[]{-android.R.attr.state_enabled},
            shape(disabledBg, radiusPx, strokePx, outline));
        states.addState(new int[]{android.R.attr.state_focused},
            shape(focusedFill, radiusPx, Math.max(strokePx, dp(1.6f)), focusStroke));
        states.addState(new int[]{}, shape(fill, radiusPx, strokePx, idleStroke));
        return states;
    }

    /** Rounded, two-layer track used by sliders and progress bars. */
    public static LayerDrawable trackDrawable(int trackColor, int fillColor, int heightPx) {
        GradientDrawable track = shape(trackColor, heightPx / 2f);
        GradientDrawable fill = shape(fillColor, heightPx / 2f);
        android.graphics.drawable.ClipDrawable clip =
            new android.graphics.drawable.ClipDrawable(
                fill, android.view.Gravity.START,
                android.graphics.drawable.ClipDrawable.HORIZONTAL);
        LayerDrawable layers = new LayerDrawable(new Drawable[]{track, clip});
        layers.setId(0, android.R.id.background);
        layers.setId(1, android.R.id.progress);
        return layers;
    }

    /** Circular slider thumb with a soft halo. */
    public static Drawable thumbDrawable(int color, int sizePx) {
        GradientDrawable thumb = new GradientDrawable();
        thumb.setShape(GradientDrawable.OVAL);
        thumb.setColor(color);
        thumb.setSize(sizePx, sizePx);
        thumb.setStroke(dp(2), 0xFFFFFFFF);
        return thumb;
    }

    /** Tint a checkbox / radio / switch to the app palette. */
    public static void tintCompound(CompoundButton button, int activeColor) {
        if (button == null) return;
        try {
            ColorStateList tint = new ColorStateList(
                new int[][]{
                    new int[]{-android.R.attr.state_enabled},
                    new int[]{android.R.attr.state_checked},
                    new int[]{},
                },
                new int[]{disabledFg, activeColor, onSurfaceVariant});
            androidx.core.widget.CompoundButtonCompat.setButtonTintList(button, tint);
        } catch (Throwable ignored) {}
    }

    /** Give a container a smooth add/remove/resize animation. */
    public static void animateLayout(ViewGroup group) {
        if (group == null) return;
        try {
            android.animation.LayoutTransition transition =
                new android.animation.LayoutTransition();
            transition.setDuration(durationMs("short_4"));
            transition.setInterpolator(easing("standard"));
            transition.enableTransitionType(android.animation.LayoutTransition.CHANGING);
            transition.setAnimateParentHierarchy(false);
            group.setLayoutTransition(transition);
        } catch (Throwable ignored) {}
    }

    /** Fade + lift a freshly created view into place. */
    public static void enter(View view, long delayMs) {
        if (view == null) return;
        try {
            view.setAlpha(0f);
            view.setTranslationY(dp(8));
            // An entering element decelerates into place: M3's
            // emphasized-decelerate at the medium-2 step.
            view.animate().alpha(1f).translationY(0f)
                .setDuration(durationMs("medium_2")).setStartDelay(delayMs)
                .setInterpolator(easing("emphasized_decelerate"))
                .start();
        } catch (Throwable ignored) {}
    }
}
