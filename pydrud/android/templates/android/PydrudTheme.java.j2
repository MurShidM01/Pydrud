    public static int onPrimary          = 0xFFFFFFFF;
    public static int primaryContainer   = 0xFFE0E7FF;
    public static int onPrimaryContainer = 0xFF312E81;
    public static int secondary          = 0xFF14B8A6;
    public static int onSecondary        = 0xFFFFFFFF;
    public static int background         = 0xFFF7F8FA;
    public static int onBackground       = 0xFF111827;
    public static int surface            = 0xFFFFFFFF;
    public static int onSurface          = 0xFF1F2937;
    public static int surfaceVariant     = 0xFFF3F4F6;
    public static int onSurfaceVariant   = 0xFF6B7280;
    public static int outline            = 0xFFE5E7EB;
    public static int outlineStrong      = 0xFFD1D5DB;
    // Material 3 surface ladder + the container roles M3 components need.
    public static int surfaceDim             = 0xFFDED8E1;
    public static int surfaceBright          = 0xFFFFFBFE;
    public static int surfaceContainerLowest = 0xFFFFFFFF;
    public static int surfaceContainerLow    = 0xFFF7F2FA;
    public static int surfaceContainer       = 0xFFF3EDF7;
    public static int surfaceContainerHigh   = 0xFFECE6F0;
    public static int surfaceContainerHighest= 0xFFE6E0E9;
    public static int surfaceTint            = 0xFF6750A4;
    public static int secondaryContainer     = 0xFFE8DEF8;
    public static int onSecondaryContainer   = 0xFF1D192B;
    public static int tertiary               = 0xFF7D5260;
    public static int tertiaryContainer      = 0xFFFFD8E4;
    public static int onTertiaryContainer    = 0xFF31111D;
    public static int errorContainer         = 0xFFF9DEDC;
    public static int onErrorContainer       = 0xFF410E0B;
    public static int outlineVariant         = 0xFFCAC4D0;
    public static int inverseSurface         = 0xFF313033;
    public static int inverseOnSurface       = 0xFFF4EFF4;
    public static int inversePrimary         = 0xFFD0BCFF;
    public static int error              = 0xFFEF4444;
    public static int onError            = 0xFFFFFFFF;
    public static int disabledBg         = 0xFFE9EAEE;
    public static int disabledFg         = 0xFFA1A7B3;
    public static int shadow             = 0xFF000000;
    public static int scrim              = 0xFF000000;
    public static boolean dark = false;

    private static boolean explicitMode = false;

    /**
     * Read Android 12+ wallpaper-derived Material You roles. The JSON shape
     * deliberately matches Python's ``Theme.payload()`` so it can make one
     * authoritative round trip through the bridge before views are rendered.
     */
    public static JSONObject systemColors(Context context) {
        JSONObject result = new JSONObject();
        try {
            if (context == null || Build.VERSION.SDK_INT < 31) {
                result.put("available", false);
                return result;
            }
            boolean night = (context.getResources().getConfiguration().uiMode
                & Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES;
            int primaryRole = night ? android.R.color.system_accent1_200
                                    : android.R.color.system_accent1_600;
            int secondaryRole = night ? android.R.color.system_accent2_200
                                      : android.R.color.system_accent2_600;
            int surfaceRole = night ? android.R.color.system_neutral1_900
                                    : android.R.color.system_neutral1_10;
            int variantRole = night ? android.R.color.system_neutral2_800
                                    : android.R.color.system_neutral2_50;
            int outlineRole = night ? android.R.color.system_neutral2_600
                                    : android.R.color.system_neutral2_400;
            result.put("available", true);
            result.put("primary", hex(context.getColor(primaryRole)));
            result.put("secondary", hex(context.getColor(secondaryRole)));
            result.put("background", hex(context.getColor(surfaceRole)));
            result.put("surface", hex(context.getColor(surfaceRole)));
            result.put("surface_variant", hex(context.getColor(variantRole)));
            result.put("outline", hex(context.getColor(outlineRole)));
            result.put("on_surface", hex(onColorFor(context.getColor(surfaceRole))));
            result.put("on_primary", hex(onColorFor(context.getColor(primaryRole))));
            result.put("dark", night);
        } catch (Exception ignored) {
            try { result.put("available", false); } catch (Exception ignoredAgain) { }
        }
        return result;
    }

    private static String hex(int color) {
        return String.format(java.util.Locale.US, "#%08X", color);
    }

    /**
     * A colour as the ``#AARRGGBB`` string the style dict speaks.
     *
     * The style pipeline is string-based end to end (Python resolves PSS to
     * hex, {@code ViewStyler.parseColor} parses it back), so anything that
     * synthesises a style value — a state layer, for instance — has to hand
     * back the same spelling rather than a packed int.
     */
    public static String toHex(int color) {
        return hex(color);
    }

    /** Adopt a palette pushed from Python. Missing roles are derived. */
    public static void apply(JSONObject scheme) {
        if (scheme == null) return;
        if (scheme.has("dark")) {
            explicitMode = true;
            if (scheme.optBoolean("dark", false)) useDark(); else useLight();
        }
        primary    = color(scheme, "primary", primary);
        secondary  = color(scheme, "secondary", secondary);
        background = color(scheme, "background", background);
        surface    = color(scheme, "surface", surface);
        onSurface  = color(scheme, "on_surface", onSurface);
        error      = color(scheme, "error", error);
        outline    = color(scheme, "outline", outline);
        derive();
        if (scheme.has("on_primary")) onPrimary = color(scheme, "on_primary", onPrimary);
        if (scheme.has("surface_variant")) {
            surfaceVariant = color(scheme, "surface_variant", surfaceVariant);
        }
        if (scheme.has("primary_container")) {
            primaryContainer = color(scheme, "primary_container", primaryContainer);
        }

        // Material 3's full role set. Every one of these is present in the
        // payload Python pushes, so components can reach for the role the
        // spec names instead of approximating it from another colour.
        onPrimaryContainer     = color(scheme, "on_primary_container", onPrimaryContainer);
        onSecondary            = color(scheme, "on_secondary", onSecondary);
        secondaryContainer     = color(scheme, "secondary_container", secondaryContainer);
        onSecondaryContainer   = color(scheme, "on_secondary_container", onSecondaryContainer);
        tertiary               = color(scheme, "tertiary", tertiary);
        tertiaryContainer      = color(scheme, "tertiary_container", tertiaryContainer);
        onTertiaryContainer    = color(scheme, "on_tertiary_container", onTertiaryContainer);
        onError                = color(scheme, "on_error", onError);
        errorContainer         = color(scheme, "error_container", errorContainer);
        onErrorContainer       = color(scheme, "on_error_container", onErrorContainer);
        onBackground           = color(scheme, "on_background", onBackground);
        onSurfaceVariant       = color(scheme, "on_surface_variant", onSurfaceVariant);
        outlineVariant         = color(scheme, "outline_variant", outlineVariant);
        inverseSurface         = color(scheme, "inverse_surface", inverseSurface);
        inverseOnSurface       = color(scheme, "inverse_on_surface", inverseOnSurface);
        inversePrimary         = color(scheme, "inverse_primary", inversePrimary);
        surfaceDim             = color(scheme, "surface_dim", surfaceDim);
        surfaceBright          = color(scheme, "surface_bright", surfaceBright);
        surfaceContainerLowest = color(scheme, "surface_container_lowest", surfaceContainerLowest);
        surfaceContainerLow    = color(scheme, "surface_container_low", surfaceContainerLow);
        surfaceContainer       = color(scheme, "surface_container", surfaceContainer);
        surfaceContainerHigh   = color(scheme, "surface_container_high", surfaceContainerHigh);
        surfaceContainerHighest= color(scheme, "surface_container_highest", surfaceContainerHighest);
        surfaceTint            = color(scheme, "surface_tint", surfaceTint);
        // The two roles nothing used to read. Both are plain black in M3; the
        // scrim's opacity belongs to the component that draws it, which is
        // why `scrimOverlay()` exists instead of a pre-dimmed colour.
        shadow                 = color(scheme, "shadow", shadow);
        scrim                  = color(scheme, "scrim", scrim);
        applyTokens(scheme.optJSONObject("tokens"));
    }

    /**
     * Follow the system dark-mode switch.
     *
     * <p>Ignored once Python has pushed an explicit {@code dark} flag, so an
     * app that forces a palette keeps it across configuration changes.
     */
    public static void setNight(boolean night) {
        if (explicitMode || night == dark) return;
        if (night) useDark(); else useLight();
    }

    public static void useLight() {
        dark = false;
        background       = 0xFFF7F8FA;
        onBackground     = 0xFF111827;
        surface          = 0xFFFFFFFF;
        onSurface        = 0xFF1F2937;
        surfaceVariant   = 0xFFF3F4F6;
        onSurfaceVariant = 0xFF6B7280;
        outline          = 0xFFE5E7EB;
        outlineStrong    = 0xFFD1D5DB;
        disabledBg       = 0xFFE9EAEE;
        disabledFg       = 0xFFA1A7B3;
        shadow           = 0xFF000000;
        scrim            = 0xFF000000;
        derive();
    }

    public static void useDark() {
        dark = true;
        background       = 0xFF0F1420;
        onBackground     = 0xFFF8FAFC;
        surface          = 0xFF18202F;
        onSurface        = 0xFFF1F5F9;
        surfaceVariant   = 0xFF222B3C;
        onSurfaceVariant = 0xFF9BA6B8;
        outline          = 0xFF2C3545;
        outlineStrong    = 0xFF3B4559;
        disabledBg       = 0xFF252D3B;
        disabledFg       = 0xFF5B6678;
        shadow           = 0x66000000;
        derive();
    }

    /** Recompute the roles that follow from primary / surface. */
    private static void derive() {
        onPrimary = onColorFor(primary);
        onSecondary = onColorFor(secondary);
        onBackground = onSurface;
        if (dark) {
            primaryContainer = blend(primary, surface, 0.78f);
            onPrimaryContainer = lighten(primary, 0.55f);
        } else {
            primaryContainer = blend(primary, 0xFFFFFFFF, 0.88f);
            onPrimaryContainer = darken(primary, 0.45f);
        }
        onError = onColorFor(error);
    }

    private static int color(JSONObject json, String name, int fallback) {
        String raw = json.optString(name, "");
        return parse(raw, fallback);
    }

    /** Parse "#AARRGGBB" / "#RRGGBB" / "#RGB", falling back when invalid. */
    public static int parse(String value, int fallback) {
        if (value == null) return fallback;
        String v = value.trim();
        if (v.isEmpty()) return fallback;
        try {
            return Color.parseColor(v);
        } catch (Exception ignored) {
            return fallback;
        }
    }

    // ── colour maths ─────────────────────────────────────────────────────

    /** Same colour at a different opacity (0..1). */
    public static int alpha(int color, float fraction) {
        int a = Math.max(0, Math.min(255, Math.round(255 * fraction)));
        return (color & 0x00FFFFFF) | (a << 24);
    }

    /** Mix {@code color} towards {@code towards} by {@code t} (0..1). */
    public static int blend(int color, int towards, float t) {
        float k = Math.max(0f, Math.min(1f, t));
        int a = Math.round(Color.alpha(color) + (Color.alpha(towards) - Color.alpha(color)) * k);
        int r = Math.round(Color.red(color)   + (Color.red(towards)   - Color.red(color))   * k);
        int g = Math.round(Color.green(color) + (Color.green(towards) - Color.green(color)) * k);
        int b = Math.round(Color.blue(color)  + (Color.blue(towards)  - Color.blue(color))  * k);
        return Color.argb(a, r, g, b);
    }

    public static int lighten(int color, float t) { return blend(color, 0xFFFFFFFF, t); }
    public static int darken(int color, float t)  { return blend(color, 0xFF0B0F17, t); }

    /** Perceived luminance test — decides black vs white content. */
    public static boolean isLight(int color) {
        double l = (0.299 * Color.red(color) + 0.587 * Color.green(color)
                  + 0.114 * Color.blue(color)) / 255.0;
        return l > 0.62;
    }

    // ── window insets ────────────────────────────────────────────────────
    //
    // Pydrud draws edge to edge: the activity reports the system-bar
    // insets here and the widgets that touch a screen edge (app bar,
    // bottom navigation, full-bleed bodies) pad themselves, so their
    // surface continues behind the status and gesture bars.

    public static int insetTop = 0;
    public static int insetBottom = 0;
    public static int insetLeft = 0;
    public static int insetRight = 0;

    public static void setInsets(int left, int top, int right, int bottom) {
        insetLeft = left;
        insetTop = top;
        insetRight = right;
        insetBottom = bottom;
    }

    /** A readable foreground colour for any background. */
    public static int onColorFor(int bg) {
        return isLight(bg) ? 0xFF111827 : 0xFFFFFFFF;
    }

    /** Ripple colour that reads on top of {@code bg}. */
    public static int rippleOn(int bg) {
        return isLight(bg) ? alpha(0xFF000000, 0.10f) : alpha(0xFFFFFFFF, 0.22f);
    }

    /**
     * Palette for charts and other multi-series graphics: brand colours
     * first, then evenly spaced hues so neighbouring series stay
     * distinguishable no matter how many there are.
     */
    public static int seriesColor(int index) {
        int i = Math.max(0, index);
        switch (i) {
            case 0: return primary;
            case 1: return secondary;
            case 2: return blend(primary, 0xFFFFFFFF, dark ? 0.35f : 0.45f);
            case 3: return error;
            default: break;
        }
        float[] hsv = new float[3];
        Color.colorToHSV(primary, hsv);
        hsv[0] = (hsv[0] + (i - 3) * 47f) % 360f;
        hsv[1] = Math.min(1f, Math.max(0.35f, hsv[1]));
        hsv[2] = dark ? Math.min(1f, hsv[2] + 0.12f) : hsv[2];
        return Color.HSVToColor(hsv);
    }

    // ── shapes, ripples, elevation ───────────────────────────────────────

    public static GradientDrawable shape(int fill, float radiusPx) {
        GradientDrawable gd = new GradientDrawable();
        gd.setShape(GradientDrawable.RECTANGLE);
        gd.setColor(fill);
        gd.setCornerRadius(radiusPx);
        return gd;
    }

    public static GradientDrawable shape(int fill, float radiusPx,
                                         int strokePx, int strokeColor) {
        GradientDrawable gd = shape(fill, radiusPx);
        if (strokePx > 0) gd.setStroke(strokePx, strokeColor);
        return gd;
    }

    /**
     * Rounded on the top corners only — the Material 3 bottom-sheet profile.
     */
    public static GradientDrawable topRoundedShape(int fill, float radiusPx) {
        GradientDrawable gd = new GradientDrawable();
        gd.setShape(GradientDrawable.RECTANGLE);
        gd.setColor(fill);
        gd.setCornerRadii(new float[]{
            radiusPx, radiusPx,   // top-left
            radiusPx, radiusPx,   // top-right
            0f, 0f,               // bottom-right
            0f, 0f,               // bottom-left
        });
        return gd;
    }

    /**
     * Rounded on one vertical edge — the Material 3 side-sheet profile.
     *
     * @param endSide round the *end* (right in LTR) corners instead of the
     *     start corners, for a sheet that slides in from the opposite edge.
     */
    public static GradientDrawable sideRoundedShape(int fill, float radiusPx,
                                                    boolean endSide) {
        GradientDrawable gd = new GradientDrawable();
        gd.setShape(GradientDrawable.RECTANGLE);
        gd.setColor(fill);
        gd.setCornerRadii(endSide
            ? new float[]{0f, 0f, radiusPx, radiusPx, radiusPx, radiusPx, 0f, 0f}
            : new float[]{radiusPx, radiusPx, 0f, 0f, 0f, 0f, radiusPx, radiusPx});
        return gd;
    }

    /** Rounded ripple over a background drawable. */
    public static Drawable ripple(Drawable content, int rippleColor, float radiusPx) {
        GradientDrawable mask = shape(0xFFFFFFFF, radiusPx);
        return new RippleDrawable(ColorStateList.valueOf(rippleColor), content, mask);
    }

    /** Circular ripple — for icon buttons and FABs. */
    public static Drawable circleRipple(Drawable content, int rippleColor) {
        ShapeDrawable mask = new ShapeDrawable(new OvalShape());
        mask.getPaint().setColor(0xFFFFFFFF);
        return new RippleDrawable(ColorStateList.valueOf(rippleColor), content, mask);
    }

    /** Add a bounded ripple on top of whatever the view already draws. */
    public static void addRipple(View view, int rippleColor, float radiusPx) {
        if (view == null) return;
        try {
            GradientDrawable mask = shape(0xFFFFFFFF, radiusPx);
            view.setForeground(new RippleDrawable(
                ColorStateList.valueOf(rippleColor), null, mask));
        } catch (Throwable ignored) {}
    }

    public static void addCircleRipple(View view, int rippleColor) {
        if (view == null) return;
        try {
            ShapeDrawable mask = new ShapeDrawable(new OvalShape());
            mask.getPaint().setColor(0xFFFFFFFF);
            view.setForeground(new RippleDrawable(
                ColorStateList.valueOf(rippleColor), null, mask));
        } catch (Throwable ignored) {}
    }

    /**
     * Flutter-style press feedback: the view dips and lifts again.
     *
     * <p>Implemented with a {@link StateListAnimator} so it never competes
     * with a touch or gesture listener bound to the same view.
     */
    public static void pressFeedback(View view, float pressedScale, float restZ, float pressedZ) {
        if (view == null) return;
        try {
            StateListAnimator sla = new StateListAnimator();

            // Press in fast and ease out, release slower: the durations are
            // the short steps of the M3 motion ladder, the curves are the
            // standard accelerate/decelerate pair.
            long downMs = durationMs("short_2");
            long upMs = durationMs("short_4");
            AnimatorSet down = new AnimatorSet();
            down.playTogether(
                ObjectAnimator.ofFloat(view, "scaleX", pressedScale).setDuration(downMs),
                ObjectAnimator.ofFloat(view, "scaleY", pressedScale).setDuration(downMs),
                ObjectAnimator.ofFloat(view, "translationZ", dp(pressedZ)).setDuration(downMs));
            down.setInterpolator(easing("standard_accelerate"));

            AnimatorSet up = new AnimatorSet();
            up.playTogether(
                ObjectAnimator.ofFloat(view, "scaleX", 1f).setDuration(upMs),
                ObjectAnimator.ofFloat(view, "scaleY", 1f).setDuration(upMs),
                ObjectAnimator.ofFloat(view, "translationZ", dp(restZ)).setDuration(upMs));
            up.setInterpolator(easing("standard_decelerate"));

            sla.addState(new int[]{android.R.attr.state_pressed}, down);
            sla.addState(new int[]{}, up);
            view.setStateListAnimator(sla);
        } catch (Throwable ignored) {}
    }

    // ── motion ───────────────────────────────────────────────────────────
    //
    // Material 3 motion is a duration step plus an easing curve, and both are
    // tokens. A component asks for a name — `medium_2`, `emphasized` — and
    // gets the token's value, so retuning either one moves every component
    // that named it instead of only the ones that were edited by hand.

    private static final java.util.HashMap<String,
        android.view.animation.Interpolator> EASING_CACHE = new java.util.HashMap<>();

    /**
     * A duration token by name, or a raw millisecond count.
     *
     * <p>Accepts the M3 steps (`short_1` … `extra_long_4`), the legacy
     * aliases (`fast`, `normal`, `slow`), a number and a numeric string, and
     * a CSS time (`300ms`, `0.3s`) — which is what a `$duration_*` reference
     * expands to in a stylesheet. Anything unrecognised falls back to the
     * default duration.
     */
    public static long durationMs(Object value) {
        if (value == null) return durationNormal;
        if (value instanceof Number) return (long) ((Number) value).doubleValue();
        String key = value.toString().trim().toLowerCase(java.util.Locale.US)
            .replace("-", "").replace("_", "").replace(" ", "");
        if (key.isEmpty()) return durationNormal;
        if (key.endsWith("ms")) {
            try { return (long) Double.parseDouble(key.substring(0, key.length() - 2)); }
            catch (NumberFormatException ignored) { return durationNormal; }
        }
        if (key.endsWith("s")) {
            try { return (long) (Double.parseDouble(key.substring(0, key.length() - 1)) * 1000); }
            catch (NumberFormatException ignored) { return durationNormal; }
        }
        switch (key) {
            case "fast":        return durationFast;
            case "normal":      return durationNormal;
            case "slow":        return durationSlow;
            case "short1":      return durationShort1;
            case "short2":      return durationShort2;
            case "short3":      return durationShort3;
            case "short4":      return durationShort4;
            case "medium1":     return durationMedium1;
            case "medium2":     return durationMedium2;
            case "medium3":     return durationMedium3;
            case "medium4":     return durationMedium4;
            case "long1":       return durationLong1;
            case "long2":       return durationLong2;
            case "long3":       return durationLong3;
            case "long4":       return durationLong4;
            case "extralong1":  return durationExtraLong1;
            case "extralong2":  return durationExtraLong2;
            case "extralong3":  return durationExtraLong3;
            case "extralong4":  return durationExtraLong4;
            default:
                try { return (long) Double.parseDouble(key); }
                catch (NumberFormatException e) { return durationNormal; }
        }
    }

    /** A duration step by name, defaulting to the token's default. */
    public static long durationMs(String step) {
        return durationMs((Object) step);
    }

    /**
     * An easing curve by name.
     *
     * <p>Three vocabularies are accepted, and they all live here so a
     * stylesheet, a widget and the framework cannot drift apart:
     *
     * <ul>
     *   <li>the M3 motion names — `standard`, `emphasized`,
     *       `standard_decelerate`, `emphasized_accelerate`, … — resolved
     *       through the {@code easing_*} tokens, so a retuned curve is picked
     *       up everywhere;</li>
     *   <li>a raw CSS timing function — `cubic-bezier(…)`, `linear()`,
     *       `steps(n)` — which is what {@code $easing_*} substitutes to;</li>
     *   <li>the platform curve names Pydrud has always accepted — `ease_out`,
     *       `ease_in_out`, `bounce`, `overshoot`, `anticipate` — kept
     *       because existing code names them.</li>
     * </ul>
     */
    public static android.view.animation.Interpolator easing(String name) {
        String key = name == null ? "" : name.trim();
        String m3 = key.toLowerCase(java.util.Locale.US).replace('_', '-');
        switch (m3) {
            case "": case "default": case "standard": key = easingStandard; break;
            case "emphasized":             key = easingEmphasized; break;
            case "standard-decelerate":    key = easingStandardDecelerate; break;
            case "standard-accelerate":    key = easingStandardAccelerate; break;
            case "emphasized-decelerate":  key = easingEmphasizedDecelerate; break;
            case "emphasized-accelerate":  key = easingEmphasizedAccelerate; break;
            default: break;
        }
        android.view.animation.Interpolator cached = EASING_CACHE.get(key);
        if (cached != null) return cached;
        android.view.animation.Interpolator built = buildEasing(key);
        EASING_CACHE.put(key, built);
        return built;
    }

    /** The M3 curve a standard transition uses. */
    public static android.view.animation.Interpolator defaultEasing() {
        return easing(easingStandard);
    }

    private static android.view.animation.Interpolator buildEasing(String key) {
        String lower = key.toLowerCase(java.util.Locale.US);
        if (lower.startsWith("cubic-bezier(")) {
            android.view.animation.Interpolator path = pathFor(lower);
            if (path != null) return path;
        }
        if (lower.startsWith("linear(")) {
            return new android.view.animation.LinearInterpolator();
        }
        if (lower.startsWith("steps(")) {
            return new StepsInterpolator(stepsFor(lower));
        }
        switch (lower.replace('_', '-')) {
            case "linear":      return new android.view.animation.LinearInterpolator();
            case "ease-in": case "accelerate":
                return new android.view.animation.AccelerateInterpolator();
            case "ease-out": case "decelerate":
                return new android.view.animation.DecelerateInterpolator();
            case "bounce":      return new android.view.animation.BounceInterpolator();
            case "overshoot":   return new android.view.animation.OvershootInterpolator();
            case "anticipate":  return new android.view.animation.AnticipateInterpolator();
            case "ease": case "ease-in-out": default:
                return new android.view.animation.AccelerateDecelerateInterpolator();
        }
    }

    /** ``cubic-bezier(x1, y1, x2, y2)``, or null when it does not parse. */
    private static android.view.animation.Interpolator pathFor(String text) {
        String inner = text.substring(text.indexOf('(') + 1);
        if (inner.contains(")")) inner = inner.substring(0, inner.indexOf(')'));
        String[] parts = inner.split(",");
        if (parts.length != 4) return null;
        try {
            return new android.view.animation.PathInterpolator(
                Float.parseFloat(parts[0].trim()),
                Float.parseFloat(parts[1].trim()),
                Float.parseFloat(parts[2].trim()),
                Float.parseFloat(parts[3].trim()));
        } catch (NumberFormatException e) {
            return null;
        }
    }

    /** The step count in a CSS ``steps(n)`` timing function. */
    private static int stepsFor(String text) {
        String inner = text.substring(text.indexOf('(') + 1);
        if (inner.contains(")")) inner = inner.substring(0, inner.indexOf(')'));
        String[] parts = inner.split(",");
        try {
            return Math.max(1, (int) Float.parseFloat(parts[0].trim()));
        } catch (NumberFormatException e) {
            return 1;
        }
    }

    /** A CSS ``steps(n)`` ramp: the value holds, then jumps. */
    static final class StepsInterpolator
            implements android.view.animation.Interpolator {
        private final int steps;

        StepsInterpolator(int steps) { this.steps = Math.max(1, steps); }

        @Override public float getInterpolation(float input) {
            if (input >= 1f) return 1f;
            return (float) Math.floor(input * steps) / steps;
        }
    }

    /** Soft, modern shadow (Material shadows are harsh by default). */
    /**
     * The M3 tonal-elevation tint for a dp elevation: levels 0-5 are 0, 5%,
     * 8%, 11%, 12% and 14% of the surface-tint role.
     */
    public static float tonalTintFor(float elevationDp) {
        // The dp ladder below is the L0-L5 scale, so a theme that retunes
        // `elevation_level_*` moves the tonal tints with it.
        float[] ladder = {elevationLevel0, elevationLevel1, elevationLevel2,
                          elevationLevel3, elevationLevel4, elevationLevel5};
        float[] tints = {tonalElevation0, tonalElevation1, tonalElevation2,
                         tonalElevation3, tonalElevation4, tonalElevation5};
        if (elevationDp <= ladder[0]) return tints[0];
        for (int i = 1; i < ladder.length; i++) {
            if (elevationDp <= ladder[i]) return tints[i];
        }
        return tints[tints.length - 1];
    }

    /**
     * Express elevation as Material 3 does on a dark surface: by tinting the
     * surface toward the surface-tint role rather than deepening a shadow.
     *
     * A shadow is invisible against a dark background, which is why M3 keeps
     * the tonal-elevation table at all. This used to blend toward *white* at
     * an invented 1.8%-per-dp rate, which drifted every dark surface away
     * from its role and ignored the table entirely.
     */
    public static int tonalSurface(int color, float elevationDp) {
        float tint = tonalTintFor(elevationDp);
        if (tint <= 0f) return color;
        return blend(color, surfaceTint, tint);
    }

    /**
     * Material 3's disabled treatment.
     *
     * A disabled container keeps 12% of its colour and its content 38%, so a
     * disabled control reads as "unavailable" without becoming unreadable.
     * Both numbers are tokens (`state_disabled_container`,
     * `state_disabled_content`) rather than literals.
     */
    public static void applyDisabledTreatment(View view, int containerColor) {
        if (view == null) return;
        if (containerColor != Color.TRANSPARENT) {
            view.setBackground(shape(
                alpha(containerColor, stateDisabledContainer), 0f));
        }
        view.setAlpha(1f);
        if (view instanceof TextView) {
            TextView tv = (TextView) view;
            tv.setTextColor(alpha(tv.getCurrentTextColor(), stateDisabledContent));
        } else if (view instanceof ImageView) {
            view.setImageAlpha(
                Math.round(255f * stateDisabledContent));
        }
    }

    /** A Material 3 state layer: the content colour at the role's opacity. */
    public static int stateLayer(int contentColor, float opacity) {
        return alpha(contentColor, opacity);
    }

    /**
     * Track a toggle's intrinsic size from its token.
     *
     * ``checkbox_size``, ``radio_size``, ``switch_width`` and ``switch_height``
     * were published and never read, so a theme that retuned them changed
     * nothing on screen. The touch target stays at the M3 minimum so a
     * smaller glyph does not shrink the tappable area.
     */
    public static void sizeToggle(View view, float sizeDp) {
        if (view == null) return;
        int px = dp(sizeDp);
        view.setMinimumWidth(px);
        view.setLayoutParams(new android.view.ViewGroup.LayoutParams(
            android.view.ViewGroup.LayoutParams.WRAP_CONTENT, px));
    }

    /**
     * Whether a scrollable view draws the overscroll glow.
     *
     * ``overscroll_glow`` was published and never read; the scroll containers
     * hard-coded ``OVER_SCROLL_IF_CONTENT_SCROLLS``.
     */
    public static int overScrollMode() {
        return overscrollGlow ? View.OVER_SCROLL_IF_CONTENT_SCROLLS
                              : View.OVER_SCROLL_NEVER;
    }

    /**
     * Snap a nominal text size to the published type scale.
     *
     * ``text_caption`` (12) and ``text_display`` (57) are the ends of the M3
     * scale; a caller that passes 0 means "use the body size", and a size past
     * display is clamped so a runaway scale cannot outgrow the screen.
     */
    public static float snapTextSize(float sizeSp) {
        if (sizeSp <= 0f) return textBody;
        if (sizeSp >= textDisplay) return textDisplay;
        if (sizeSp <= textCaption) return textCaption;
        return sizeSp;
    }

    /** The layer a row wears while it is being dragged (``stateDragged``). */
    public static int draggedLayer() {
        return alpha(onSurface, stateDragged);
    }

    /**
     * The M3 modal scrim: {@code scrim} composited at the spec's 32 %.
     *
     * <p>Every modal surface dims what is behind it by this much, and a theme
     * that changes the scrim role changes all of them — which is the point of
     * shipping the role at all.
     */
    public static int scrimOverlay() {
        return alpha(scrim, SCRIM_ALPHA);
    }

    /** The share of the scrim role a modal surface composites. */
    public static final float SCRIM_ALPHA = 0.32f;

    public static void elevate(View view, float elevationDp) {
        if (view == null) return;
        try {
            view.setElevation(dp(elevationDp));
            if (Build.VERSION.SDK_INT >= 28) {
                view.setOutlineSpotShadowColor(shadow);
                view.setOutlineAmbientShadowColor(alpha(shadow, 0.10f));
            }
        } catch (Throwable ignored) {}
    }

