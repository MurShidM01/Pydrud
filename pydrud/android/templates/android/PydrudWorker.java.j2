package {{ package }};

import android.content.Context;
import android.util.Log;

import androidx.annotation.NonNull;
import androidx.work.Data;
import androidx.work.Worker;
import androidx.work.WorkerParameters;

/**
 * PydrudWorker — runs a Python background job scheduled with
 * {@code page.background.schedule(...)}.
 *
 * WorkManager may start this long after the Activity is gone, so the worker
 * boots the project's Python backend when needed and calls
 * {@code {{ python_entry | default('app.main') }}.run_background_job(name, inputs_json)}.
 * The backend is chosen at build time (see {@link PydrudRuntimeFactory}).
 */
public class PydrudWorker extends Worker {

    private static final String TAG = "PydrudWorker";

    public PydrudWorker(@NonNull Context context,
                        @NonNull WorkerParameters params) {
        super(context, params);
    }

    @NonNull
    @Override
    public Result doWork() {
        Data input = getInputData();
        String job = input.getString("pydrud_job");
        String inputs = input.getString("pydrud_inputs");
        if (job == null || job.isEmpty()) {
            return Result.failure();
        }

        try {
            PythonRuntime runtime = PydrudRuntimeFactory.create();
            runtime.start(getApplicationContext());
            String text = runtime.callBackgroundJob(
                "{{ python_entry | default('app.main') }}", job,
                inputs == null ? "{}" : inputs);
            Data output = new Data.Builder()
                .putString("result", text == null ? "" : text)
                .build();
            return Result.success(output);
        } catch (Exception e) {
            Log.e(TAG, "background job '" + job + "' failed", e);
            // Transient failures (no network, DB locked) are worth retrying;
            // WorkManager applies exponential backoff automatically.
            return getRunAttemptCount() < 3 ? Result.retry() : Result.failure();
        }
    }
}
