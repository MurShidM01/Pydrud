# Pydrud R8 / ProGuard configuration.
#
# Shrinking is off by default; enable it with:
#     pydrud build --release --shrink
# Typical savings are 30-40% of the Java/Kotlin portion of the APK. The
# Python runtime and your .py sources are assets, so they are untouched —
# use `pydrud build --release --abi arm64-v8a` to halve *that* half.

{% if (runtime_backend | default('chaquopy')) == 'chaquopy' %}
# ── Chaquopy / Python runtime ────────────────────────────────────────────
-keep class com.chaquo.python.** { *; }
-keep class org.jetbrains.annotations.** { *; }
-dontwarn com.chaquo.python.**
{% endif %}

# ── Pydrud runtime backend ───────────────────────────────────────────────
# PydrudRuntimeFactory constructs the active backend by name, so R8 must not
# strip it or the interface it implements.
-keep class {{ package }}.PydrudRuntimeFactory { *; }
-keep class {{ package }}.PythonRuntime { *; }
{% if (runtime_backend | default('chaquopy')) == 'chaquopy' %}
-keep class {{ package }}.ChaquopyRuntime { *; }
{% elif (runtime_backend | default('chaquopy')) == 'host' %}
-keep class {{ package }}.HostRuntime { *; }
-keep class {{ package }}.PydrudRuntimeConfig { *; }
{% else %}
-keep class {{ package }}.NoRuntime { *; }
{% endif %}

# Python calls into these by name through reflection, so they must keep
# their exact names even when everything else is renamed.
-keep class {{ package }}.{{ app_name }}Activity { *; }
-keep class {{ package }}.BridgeService { *; }
-keep class {{ package }}.ViewFactory { *; }
-keep class {{ package }}.MaterialViews { *; }
-keep class {{ package }}.AdvancedViews { *; }
-keep class {{ package }}.NativeServices { *; }
-keep class {{ package }}.PlatformServices { *; }
-keep class {{ package }}.GestureBinder { *; }
-keep class {{ package }}.EventDispatcher { *; }
-keep class {{ package }}.PydrudWorker { *; }
-keep class {{ package }}.WidgetRegistry { *; }

# ── AndroidX pieces reached reflectively ─────────────────────────────────
-keep class androidx.work.** { *; }
{% if camera | default(false) %}
-keep class androidx.camera.** { *; }
{% endif %}
-keep class androidx.security.crypto.** { *; }
-keep class androidx.biometric.** { *; }
-keepclassmembers class * extends androidx.work.Worker {
    public <init>(android.content.Context, androidx.work.WorkerParameters);
}

# Views inflated from XML / by name.
-keepclassmembers class * extends android.view.View {
    public <init>(android.content.Context);
    public <init>(android.content.Context, android.util.AttributeSet);
    public void set*(***);
    *** get*();
}

# Keep annotations and signatures so reflection and stack traces survive.
-keepattributes *Annotation*, Signature, InnerClasses, EnclosingMethod
-keepattributes SourceFile, LineNumberTable
-renamesourcefileattribute SourceFile

# ── Optional integrations ────────────────────────────────────────────────
-dontwarn com.google.firebase.**
-keep class com.google.firebase.** { *; }
-dontwarn org.osmdroid.**
