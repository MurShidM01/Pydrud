package {{ package }};

/**
 * Compile-time runtime configuration, generated by {@code pydrud sync}.
 *
 * Do not edit by hand: change {@code pydrud.yaml} (or run
 * {@code pydrud init android --backend …}) and re-sync.
 */
public final class PydrudRuntimeConfig {

    private PydrudRuntimeConfig() {
    }

    /** The selected backend: {@code "chaquopy"}, {@code "host"} or
     *  {@code "none"}. */
    public static final String BACKEND = "{{ runtime_backend | default('chaquopy') }}";

    /** Host backend: the machine running {@code pydrud dev}. */
    public static final String REMOTE_HOST = "{{ preview_host | default('127.0.0.1') }}";

    /** Host backend: the bridge port the host listens on. */
    public static final int REMOTE_PORT = {{ preview_port | default(8597) }};
}
