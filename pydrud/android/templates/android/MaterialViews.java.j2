    // ── media ────────────────────────────────────────────────────────────

    private View createWebView(final String key, JSONObject p) {
        WebView web = new WebView(activity);
        web.getSettings().setJavaScriptEnabled(p.optBoolean("javascript", false));
        web.getSettings().setBuiltInZoomControls(p.optBoolean("zoom", false));
        web.getSettings().setDisplayZoomControls(false);
        web.setWebChromeClient(new WebChromeClient());
        web.setWebViewClient(new WebViewClient() {
            @Override public void onPageFinished(WebView view, String url) {
                if (events != null) {
                    JSONObject data = new JSONObject();
                    try { data.put("url", url); } catch (Exception ignored) {}
                    events.dispatch("load", key, data);
                }
            }
        });
        if (p.optBoolean("javascript", false) && p.optBoolean("allowNativeBridge", false)) {
            web.addJavascriptInterface(new JsBridge(key), "Pydrud");
        }
        String html = p.optString("html", "");
        String url = p.optString("url", "");
        if (!html.isEmpty()) {
            web.loadDataWithBaseURL(null, html, "text/html", "utf-8", null);
        } else if (!url.isEmpty()) {
            web.loadUrl(url);
        }
        return web;
    }

    /** Exposes {@code Pydrud.postMessage("…")} to the hosted page. */
    public class JsBridge {
        private final String key;

        JsBridge(String key) { this.key = key; }

        @android.webkit.JavascriptInterface
        public void postMessage(String message) {
            if (events == null) return;
            JSONObject data = new JSONObject();
            try { data.put("message", message); } catch (Exception ignored) {}
            events.dispatch("message", key, data);
        }
    }

    private View createVideo(final String key, JSONObject p) {
        VideoView video = new VideoView(activity);
        String source = p.optString("source", "");
        if (!source.isEmpty()) {
            video.setVideoURI(android.net.Uri.parse(source));
        }
        if (p.optBoolean("controls", true)) {
            android.widget.MediaController controller =
                new android.widget.MediaController(activity);
            controller.setAnchorView(video);
            video.setMediaController(controller);
        }
        final boolean loop = p.optBoolean("loop", false);
        video.setOnPreparedListener(new android.media.MediaPlayer.OnPreparedListener() {
            @Override public void onPrepared(android.media.MediaPlayer mp) {
                mp.setLooping(loop);
                if (p.optBoolean("muted", false)) mp.setVolume(0f, 0f);
            }
        });
        video.setOnCompletionListener(new android.media.MediaPlayer.OnCompletionListener() {
            @Override public void onCompletion(android.media.MediaPlayer mp) {
                if (events != null) events.dispatch("complete", key, null);
            }
        });
        if (p.optBoolean("autoplay", false)) video.start();
        return video;
    }

    // ── wrappers ─────────────────────────────────────────────────────────

    private View createWrapper(String type, JSONObject p) {
        if ("Drawer".equals(type)) {
            LinearLayout drawer = new LinearLayout(activity);
            drawer.setOrientation(LinearLayout.VERTICAL);
            drawer.setBackgroundColor(parseColor(p.optString("bg", ""), PydrudTheme.surface));
            drawer.setVisibility(View.GONE);   // opened via the drawer command
            return drawer;
        }
        if ("Form".equals(type) || "FormField".equals(type)) {
            LinearLayout column = new LinearLayout(activity);
            column.setOrientation(LinearLayout.VERTICAL);
            String label = p.optString("label", "");
            if (!label.isEmpty()) {
                TextView text = new TextView(activity);
                text.setText(label);
                text.setTextSize(13);
                text.setTextColor(PydrudTheme.onSurfaceVariant);
                text.setPadding(0, 0, 0, dp(4));
                column.addView(text);
            }
            return column;
        }
        // A known wrapper type draws nothing of its own; anything else is a
        // factory we are missing, and says so loudly.
        if (!KNOWN_WRAPPERS.contains(type)) {
            lastUnhandledType = type;
            Log.w(TAG, "no factory for widget type \"" + type
                + "\" — falling back to a transparent container. "
                + "Add a case in MaterialViews.create().");
        }
        return new FrameLayout(activity);
    }

    /** Appends the error/helper line under a FormField after its child. */
    public void decorateFormField(View view, JSONObject props) {
        if (!(view instanceof LinearLayout)) return;
        String error = props.optString("error", "");
        String helper = props.optString("helper", "");
        if (error.isEmpty() && helper.isEmpty()) return;
        TextView text = new TextView(activity);
        text.setText(error.isEmpty() ? helper : error);
        text.setTextSize(12);
        text.setPadding(0, dp(4), 0, 0);
        text.setTextColor(error.isEmpty()
            ? PydrudTheme.onSurfaceVariant
            : parseColor(props.optString("errorColor", ""), PydrudTheme.error));
        ((LinearLayout) view).addView(text);
    }

    // ── menus ────────────────────────────────────────────────────────────

    /**
     * The trigger a {@link android.widget.PopupMenu} anchors to.
     *
     * <p>Returns a host the factory can also attach a caller-supplied trigger
     * to. Unless the Python side sent one (``customTrigger``), a 48dp
     * overflow button is built here — an icon button, or a text button when
     * a label is given. The menu itself is built and shown by
     * {@code ViewFactory.bindPopupMenu} when the trigger is tapped, so items
     * added by a later patch are always the ones shown.
     */
    private View createPopupMenu(final String key, JSONObject p) {
        FrameLayout host = new FrameLayout(activity);
        host.setClipChildren(false);
        int tint = parseColor(p.optString("color", ""), PydrudTheme.onSurfaceVariant);

        if (!p.optBoolean("customTrigger", false)) {
            String label = p.optString("label", "");
            if (!label.isEmpty()) {
                TextView trigger = new TextView(activity);
                trigger.setText(label);
                PydrudTheme.applyTextDefaults(trigger, 14f, 500, tint);
                trigger.setGravity(Gravity.CENTER);
                trigger.setPadding(dp(12), dp(10), dp(12), dp(10));
                host.addView(trigger, new FrameLayout.LayoutParams(
                    ViewGroup.LayoutParams.WRAP_CONTENT,
                    ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.CENTER));
            } else {
                ImageView trigger = new ImageView(activity);
                trigger.setImageDrawable(factory.icon(
                    p.optString("icon", "more_vert"), tint, PydrudTheme.adaptive(24)));
                trigger.setScaleType(ImageView.ScaleType.FIT_CENTER);
                int box = PydrudTheme.touchTarget();
                host.addView(trigger, new FrameLayout.LayoutParams(
                    box, box, Gravity.CENTER));
            }
        }
        host.setMinimumWidth(PydrudTheme.touchTarget());
        host.setMinimumHeight(PydrudTheme.touchTarget());
        return host;
    }

    // ── overlays ─────────────────────────────────────────────────────────

    /**
     * Declarative modal overlays ({@code AlertDialog}, {@code ModalBottomSheet}).
     *
     * <p>The widget is a zero-size host: showing it in the tree shows the
     * native dialog, removing it dismisses the dialog. Buttons dispatch a
     * {@code click} event on the widget's key carrying the chosen value
     * (``{"action": "delete"}`` for a dialog, ``{"index": 2}`` for a sheet),
     * and an outside/back dismissal dispatches {@code dismiss}.
     */
    private View createOverlay(final String key, final JSONObject p, final String type) {
        final FrameLayout host = new FrameLayout(activity);
        host.setMinimumWidth(0);
        host.setMinimumHeight(0);
        host.addOnAttachStateChangeListener(new View.OnAttachStateChangeListener() {
            android.app.Dialog dialog;
            boolean selfClosing;

            @Override public void onViewAttachedToWindow(View v) {
                if (dialog != null) return;
                // Only these two types reach createOverlay; anything else
                // with a dialog needs its own factory.
                dialog = "ModalBottomSheet".equals(type)
                    ? buildBottomSheet(key, p)
                    : buildAlertDialog(key, p);
                dialog.setOnDismissListener(d -> {
                    dialog = null;
                    if (!selfClosing && events != null) {
                        events.dispatch("dismiss", key, null);
                    }
                });
                dialog.show();
            }

            @Override public void onViewDetachedFromWindow(View v) {
                if (dialog == null) return;
                selfClosing = true;
                dialog.dismiss();
                selfClosing = false;
                dialog = null;
            }
        });
        return host;
    }

    private android.app.Dialog buildAlertDialog(final String key, JSONObject p) {
        com.google.android.material.dialog.MaterialAlertDialogBuilder builder =
            new com.google.android.material.dialog.MaterialAlertDialogBuilder(activity);
        // The dialog surface takes its radius and elevation from the tokens, so
        // a theme retunes every dialog at once instead of each call site
        // carrying its own literal.
        final android.graphics.drawable.Drawable dialogSurface = PydrudTheme.shape(
            PydrudTheme.surfaceContainerHigh, PydrudTheme.dp(PydrudTheme.radiusDialog));
        String title = p.optString("title", "");
        String message = p.optString("message", "");
        if (!title.isEmpty()) builder.setTitle(title);
        if (!message.isEmpty()) builder.setMessage(message);
        String icon = p.optString("icon", "");
        if (!icon.isEmpty()) {
            builder.setIcon(factory.icon(icon, PydrudTheme.primary, dp(24)));
        }
        boolean dismissible = p.optBoolean("dismissible", true);
        builder.setCancelable(dismissible);

        // Actions render left→right in the order Python declared them, so the
        // last one is the affirmative (right-most) button — matching Flutter's
        // AlertDialog.actions.
        JSONArray actions = p.optJSONArray("actions");
        int n = actions != null ? actions.length() : 0;
        if (n >= 3) {
            JSONObject a = actions.optJSONObject(n - 3);
            builder.setNeutralButton(a != null ? a.optString("label", "") : "",
                (d, w) -> fireAction(key, a != null ? a.optString("value", "") : ""));
        }
        if (n >= 2) {
            JSONObject a = actions.optJSONObject(n - 2);
            builder.setNegativeButton(a != null ? a.optString("label", "") : "",
                (d, w) -> fireAction(key, a != null ? a.optString("value", "") : ""));
        }
        if (n >= 1) {
            JSONObject a = actions.optJSONObject(n - 1);
            builder.setPositiveButton(a != null ? a.optString("label", "") : "",
                (d, w) -> fireAction(key, a != null ? a.optString("value", "") : ""));
        }
        final android.app.Dialog dialog = builder.create();
        dialog.setOnShowListener(d -> {
            android.view.Window w = dialog.getWindow();
            if (w == null) return;
            w.setBackgroundDrawable(dialogSurface);
            PydrudTheme.elevate(w.getDecorView(), PydrudTheme.elevationDialog);
        });
        return dialog;
    }

    private android.app.Dialog buildBottomSheet(final String key, JSONObject p) {
        final com.google.android.material.bottomsheet.BottomSheetDialog dialog =
            new com.google.android.material.bottomsheet.BottomSheetDialog(activity);
        dialog.setOnShowListener(d -> {
            android.view.View sheet = dialog.findViewById(
                com.google.android.material.R.id.design_bottom_sheet);
            if (sheet != null) {
                sheet.setBackground(PydrudTheme.topRoundedShape(
                    PydrudTheme.surfaceContainerLow,
                    PydrudTheme.dp(PydrudTheme.radiusSheet)));
                PydrudTheme.elevate(sheet, PydrudTheme.elevationSheet);
            }
        });
        boolean dismissible = p.optBoolean("dismissible", true);
        dialog.setCancelable(dismissible);
        dialog.setCanceledOnTouchOutside(dismissible);

        LinearLayout column = new LinearLayout(activity);
        column.setOrientation(LinearLayout.VERTICAL);
        column.setBackgroundColor(PydrudTheme.surface);
        column.setPadding(0, dp(12), 0, dp(12));

        View handle = new View(activity);
        GradientDrawable handleBg = new GradientDrawable();
        handleBg.setColor(PydrudTheme.onSurfaceVariant);
        handleBg.setCornerRadius(dp(2));
        handle.setBackground(handleBg);
        LinearLayout.LayoutParams hlp = new LinearLayout.LayoutParams(dp(32), dp(4));
        hlp.gravity = Gravity.CENTER_HORIZONTAL;
        hlp.bottomMargin = dp(8);
        column.addView(handle, hlp);

        String title = p.optString("title", "");
        if (!title.isEmpty()) {
            TextView heading = new TextView(activity);
            heading.setText(title);
            PydrudTheme.applyTextDefaults(heading, 16f, 600, PydrudTheme.onSurface);
            heading.setPadding(dp(20), dp(8), dp(20), dp(12));
            column.addView(heading);
        }

        JSONArray options = p.optJSONArray("options");
        JSONArray icons = p.optJSONArray("icons");
        for (int i = 0; options != null && i < options.length(); i++) {
            final String label = options.optString(i, "");
            final int index = i;
            String icon = icons != null ? icons.optString(i, "") : "";

            LinearLayout row = new LinearLayout(activity);
            row.setOrientation(LinearLayout.HORIZONTAL);
            row.setGravity(Gravity.CENTER_VERTICAL);
            row.setPadding(dp(20), dp(14), dp(20), dp(14));
            row.setBackground(PydrudTheme.ripple(
                PydrudTheme.shape(Color.TRANSPARENT, 0),
                PydrudTheme.alpha(PydrudTheme.primary, PydrudTheme.rippleOpacity), 0));
            if (!icon.isEmpty()) {
                ImageView iv = new ImageView(activity);
                iv.setImageDrawable(factory.icon(
                    icon, PydrudTheme.onSurfaceVariant, dp(22)));
                LinearLayout.LayoutParams ilp =
                    new LinearLayout.LayoutParams(dp(22), dp(22));
                ilp.rightMargin = dp(16);
                row.addView(iv, ilp);
            }
            TextView text = new TextView(activity);
            text.setText(label);
            PydrudTheme.applyTextDefaults(text, 15f, 500, PydrudTheme.onSurface);
            row.addView(text, new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.WRAP_CONTENT));
            row.setOnClickListener(v -> {
                fireSheetAction(key, index, label);
                dialog.dismiss();
            });
            column.addView(row, new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.WRAP_CONTENT));
        }

        android.widget.ScrollView scroll = new android.widget.ScrollView(activity);
        scroll.addView(column);
        dialog.setContentView(scroll);
        return dialog;
    }

    private void fireAction(String key, String value) {
        if (events == null) return;
        JSONObject data = new JSONObject();
        try { data.put("action", value); } catch (Exception ignored) { }
        events.dispatch("click", key, data);
    }

    private void fireSheetAction(String key, int index, String label) {
        if (events == null) return;
        JSONObject data = new JSONObject();
        try {
            data.put("index", index);
            data.put("label", label);
        } catch (Exception ignored) { }
        events.dispatch("click", key, data);
    }

    // ── AnimatedSwitcher ─────────────────────────────────────────────────

    /**
     * A cross-fading container. When its child is replaced, the outgoing
     * view fades out (and is removed once invisible) while the incoming view
     * fades in, so "loading → content" swaps read as a transition rather
     * than a flicker.
     */
    private View createAnimatedSwitcher(String key, JSONObject p) {
        return new SwitcherView(activity, p.optString("transition", "fade"),
                                p.optInt("duration", 250));
    }

    static class SwitcherView extends FrameLayout {
        private final String transition;
        private final int duration;

        SwitcherView(Context context, String transition, int duration) {
            super(context);
            this.transition = transition;
            this.duration = Math.max(60, duration);
        }

        @Override public void removeView(View view) {
            if (view == null || view.getParent() != this) {
                super.removeView(view);
                return;
            }
            // Keep the outgoing view for the length of the fade so the
            // incoming view can fade over the top of it.
            view.animate().cancel();
            view.animate().alpha(0f).setDuration(duration)
                .withEndAction(() -> {
                    if (view.getParent() == this) SwitcherView.super.removeView(view);
                }).start();
        }

        @Override public void addView(View child, int index, ViewGroup.LayoutParams params) {
            child.animate().cancel();
            if (child.getParent() == this) {
                // A "move" patch removes and re-adds the *same* view: cancel
                // the pending fade-out and reposition instead of cross-fading.
                child.setAlpha(1f);
                resetTransform(child);
                SwitcherView.super.removeView(child);
                SwitcherView.super.addView(child, index, params);
                return;
            }
            child.setAlpha(0f);
            float dx = 0f, dy = 0f, scale = 1f;
            if ("slide_up".equals(transition))         dy = dpf(24);
            else if ("slide_down".equals(transition))  dy = -dpf(24);
            else if ("slide_left".equals(transition))  dx = dpf(24);
            else if ("slide_right".equals(transition)) dx = -dpf(24);
            else if ("scale".equals(transition))       scale = 0.9f;
            child.setTranslationX(dx);
            child.setTranslationY(dy);
            child.setScaleX(scale);
            child.setScaleY(scale);
            SwitcherView.super.addView(child, index, params);
            child.animate().alpha(1f).translationX(0f).translationY(0f)
                .scaleX(1f).scaleY(1f).setDuration(duration).start();
        }

        private void resetTransform(View child) {
            child.setTranslationX(0f);
            child.setTranslationY(0f);
            child.setScaleX(1f);
            child.setScaleY(1f);
        }

        private float dpf(float value) {
            return value * getResources().getDisplayMetrics().density;
        }
    }

    // ── helpers ──────────────────────────────────────────────────────────

    boolean containsIndex(JSONArray array, int index) {
        if (array == null) return false;
        for (int i = 0; i < array.length(); i++) {
            if (array.optInt(i, -1) == index) return true;
        }
        return false;
    }

    float[] cornerRadii(int index, int count) {
        float r = dp(20);
        boolean first = index == 0;
        boolean last = index == count - 1;
        return new float[] {
            first ? r : 0, first ? r : 0,
            last ? r : 0,  last ? r : 0,
            last ? r : 0,  last ? r : 0,
            first ? r : 0, first ? r : 0,
        };
    }

    int withAlpha(int color, int alpha) {
        return Color.argb(alpha, Color.red(color), Color.green(color),
                          Color.blue(color));
    }

    int parseColor(String value) {
        try {
            return Color.parseColor(value);
        } catch (Exception e) {
            return PydrudTheme.primary;
        }
    }

    int dp(int value) {
        return PydrudTheme.dp(value);
    }

    int dp(float value) {
        return PydrudTheme.dp(value);
    }

    int parseColor(String value, int fallback) {
        return PydrudTheme.parse(value, fallback);
    }

    /**
     * ChartView — a tiny Canvas chart (line / area / bar / pie) so apps can
     * show data without pulling in a charting dependency.
     */
    public static class ChartView extends View {

        private final JSONObject props;
        private final android.graphics.Paint paint = new android.graphics.Paint(
            android.graphics.Paint.ANTI_ALIAS_FLAG);

        public ChartView(Context context, JSONObject props) {
            super(context);
            this.props = props == null ? new JSONObject() : props;
        }

        @Override protected void onDraw(android.graphics.Canvas canvas) {
            super.onDraw(canvas);
            JSONArray values = props.optJSONArray("values");
            if (values == null || values.length() == 0) return;
            String kind = props.optString("kind", "line");
            int count = values.length();
            float max = (float) Math.max(0.0001, props.optDouble("max", 1));
            float w = getWidth();
            float h = getHeight();
            float pad = h * 0.08f;
            int color = firstColor();

            paint.setStrokeWidth(Math.max(2f, h * 0.02f));
            paint.setColor(color);

            if ("pie".equals(kind)) {
                drawPie(canvas, values, w, h);
                return;
            }
            if (props.optBoolean("showGrid", true)) {
                paint.setColor(PydrudTheme.outline);
                paint.setStyle(android.graphics.Paint.Style.STROKE);
                for (int i = 0; i <= 4; i++) {
                    float y = pad + (h - 2 * pad) * i / 4f;
                    canvas.drawLine(0, y, w, y, paint);
                }
                paint.setColor(color);
            }
            float step = count > 1 ? w / (count - 1) : w;
            if ("bar".equals(kind)) {
                paint.setStyle(android.graphics.Paint.Style.FILL);
                float barWidth = w / (count * 1.6f);
                for (int i = 0; i < count; i++) {
                    float value = (float) values.optDouble(i, 0);
                    float barHeight = (h - 2 * pad) * (value / max);
                    float cx = (i + 0.5f) * (w / count);
                    float radius = Math.min(barWidth / 2f, PydrudTheme.dp(6));
                    canvas.drawRoundRect(cx - barWidth / 2, h - pad - barHeight,
                                         cx + barWidth / 2, h - pad,
                                         radius, radius, paint);
                }
                return;
            }
            android.graphics.Path path = new android.graphics.Path();
            for (int i = 0; i < count; i++) {
                float value = (float) values.optDouble(i, 0);
                float x = i * step;
                float y = h - pad - (h - 2 * pad) * (value / max);
                if (i == 0) path.moveTo(x, y); else path.lineTo(x, y);
            }
            paint.setStyle(android.graphics.Paint.Style.STROKE);
            canvas.drawPath(path, paint);
            if ("area".equals(kind)) {
                path.lineTo(w, h - pad);
                path.lineTo(0, h - pad);
                path.close();
                paint.setStyle(android.graphics.Paint.Style.FILL);
                paint.setAlpha(60);
                canvas.drawPath(path, paint);
                paint.setAlpha(255);
            }
        }

        private void drawPie(android.graphics.Canvas canvas, JSONArray values,
                             float w, float h) {
            float total = 0;
            for (int i = 0; i < values.length(); i++) {
                total += (float) values.optDouble(i, 0);
            }
            if (total <= 0) return;
            float size = Math.min(w, h);
            android.graphics.RectF box = new android.graphics.RectF(
                (w - size) / 2f, (h - size) / 2f,
                (w + size) / 2f, (h + size) / 2f);
            float start = -90f;
            JSONArray colors = props.optJSONArray("colors");
            paint.setStyle(android.graphics.Paint.Style.FILL);
            for (int i = 0; i < values.length(); i++) {
                float sweep = 360f * (float) values.optDouble(i, 0) / total;
                String c = colors != null
                    ? colors.optString(i % Math.max(1, colors.length()), "")
                    : "";
                // Unlabelled slices walk the theme palette instead of
                // repeating one colour.
                paint.setColor(c.isEmpty()
                    ? PydrudTheme.seriesColor(i)
                    : PydrudTheme.parse(c, PydrudTheme.seriesColor(i)));
                canvas.drawArc(box, start, sweep, true, paint);
                start += sweep;
            }
        }

        private int firstColor() {
            JSONArray colors = props.optJSONArray("colors");
            if (colors != null && colors.length() > 0) {
                return PydrudTheme.parse(colors.optString(0, ""),
                                         PydrudTheme.primary);
            }
            return PydrudTheme.primary;
        }
    }

    // ══════════════════════════════════════════════════════════════════════
    // Material 3 component factories
    // ══════════════════════════════════════════════════════════════════════

    /** Snackbar — transient bottom message with optional action. */
    private View createSnackbar(String key, JSONObject props) {
        LinearLayout row = new LinearLayout(activity);
        row.setOrientation(LinearLayout.HORIZONTAL);
        row.setGravity(Gravity.CENTER_VERTICAL);
        int pad = PydrudTheme.dp(12);
        row.setPadding(pad, pad, pad, pad);
        row.setBackground(PydrudTheme.shape(
            PydrudTheme.inverseSurface,
            PydrudTheme.dp(PydrudTheme.radiusSnackbar)));

        String message = props.optString("message", "");
        TextView tv = new TextView(activity);
        tv.setText(message);
        tv.setTextColor(PydrudTheme.inverseOnSurface);
        PydrudTheme.applyTextDefaults(tv, 14, 400, PydrudTheme.inverseOnSurface);
        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(
            0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f);
        row.addView(tv, lp);

        String action = props.optString("action", "");
        if (!action.isEmpty()) {
            TextView btn = new TextView(activity);
            btn.setText(action);
            btn.setTextColor(PydrudTheme.primary);
            PydrudTheme.applyTextDefaults(btn, 14, 500, PydrudTheme.primary);
            btn.setPaddingRelative(PydrudTheme.dp(8), 0, 0, 0);
            btn.setClickable(true);
            btn.setOnClickListener(v -> {
                if (events != null) events.dispatch("action", key, null);
            });
            row.addView(btn);
        }
        return row;
    }

    // ══════════════════════════════════════════════════════════════════════
    // Material 3 pickers — real MaterialDatePicker / MaterialTimePicker
    // ══════════════════════════════════════════════════════════════════════
    //
    // Both Material pickers are DialogFragments rather than Dialogs, so the
    // host talks to a small adapter instead of a raw dialog: it can show
    // either backing, dismiss it, and report one dismiss callback. The
    // wrapper view stays in the tree (so layout, patching and removal all
    // behave normally) and owns the picker's lifetime: attaching opens it,
    // detaching dismisses it. The platform DatePickerDialog and
    // TimePickerDialog remain the fallback when Material is unavailable.

    /** A live picker, backed by either a Dialog or a DialogFragment. */
    private static final class ShownPicker {
        private final android.app.Dialog dialog;
        private final androidx.fragment.app.DialogFragment fragment;
        private final Runnable opener;
        private Runnable onDismissed;

        ShownPicker(android.app.Dialog dialog) {
            this.dialog = dialog;
            this.fragment = null;
            this.opener = null;
        }

        ShownPicker(androidx.fragment.app.DialogFragment fragment, Runnable opener) {
            this.dialog = null;
            this.fragment = fragment;
            this.opener = opener;
        }

        void setOnDismissed(Runnable callback) {
            onDismissed = callback;
        }

        void show() {
            if (fragment != null) {
                // Material pickers create their dialog asynchronously through
                // the FragmentManager; their own listeners report the result,
                // so there is no dialog to attach to here.
                if (opener != null) opener.run();
            } else if (dialog != null) {
                dialog.setOnDismissListener(ignored -> {
                    if (onDismissed != null) onDismissed.run();
                });
                dialog.show();
            }
        }

        void dismiss() {
            if (fragment != null) {
                try {
                    fragment.dismiss();
                } catch (Exception ignored) {}
            } else if (dialog != null) {
                dialog.dismiss();
            }
        }
    }

    /** Owns one picker's lifetime for as long as its host view is attached. */
    private final class PickerHost implements View.OnAttachStateChangeListener {
        private final String key;
        private final String kind;
        private final JSONObject props;
        private ShownPicker picker;
        private boolean selfClosing;
        private boolean settled;

        PickerHost(String key, String kind, JSONObject props) {
            this.key = key;
            this.kind = kind;
            this.props = props;
        }

        /** The user picked a value or explicitly cancelled the picker. */
        void markSettled() {
            settled = true;
        }

        @Override public void onViewAttachedToWindow(View v) {
            if (picker != null) return;
            settled = false;
            picker = "time".equals(kind)
                ? buildMaterialTimePicker(key, props, this)
                : buildMaterialDatePicker(key, props, this);
            if (picker == null) return;
            picker.setOnDismissed(this::onPickerDismissed);
            picker.show();
        }

        @Override public void onViewDetachedFromWindow(View v) {
            close();
        }

        private void onPickerDismissed() {
            picker = null;
            // A confirmed or cancelled picker already reported itself.
            if (selfClosing || settled) return;
            JSONObject data = new JSONObject();
            try { data.put("dismissed", true); } catch (Exception ignored) {}
            if (events != null) events.dispatch("cancel", key, data);
        }

        void close() {
            ShownPicker current = picker;
            if (current == null) return;
            selfClosing = true;
            picker = null;
            current.dismiss();
            selfClosing = false;
        }
    }

    /** Shared host for any dialog-backed picker. */
    private View pickerHost(final String key, final String kind, final JSONObject p) {
        final FrameLayout host = new FrameLayout(activity);
        host.setMinimumWidth(0);
        host.setMinimumHeight(0);
        host.addOnAttachStateChangeListener(new PickerHost(key, kind, p));
        return host;
    }

    /** Material date picker. */
    private View createDatePicker(String key, JSONObject p) {
        return pickerHost(key, "date", p);
    }

    /** Material date *range* picker — two-month grid with a start/end span. */
    private View createDateRangePicker(String key, JSONObject p) {
        JSONObject rangeProps = p;
        try {
            rangeProps = new JSONObject(p.toString());
            rangeProps.put("range", true);
        } catch (Exception ignored) {}
        return pickerHost(key, "date", rangeProps);
    }

    /** Material time picker with the M3 clock dial. */
    private View createTimePicker(String key, JSONObject p) {
        return pickerHost(key, "time", p);
    }

    /** Show a Material picker fragment and adapt it to the host. */
    private ShownPicker materialFragment(
            final androidx.fragment.app.DialogFragment fragment, final String tag) {
        if (!(activity instanceof androidx.fragment.app.FragmentActivity)) {
            return null;
        }
        final androidx.fragment.app.FragmentActivity host =
            (androidx.fragment.app.FragmentActivity) activity;
        return new ShownPicker(fragment, () -> {
            try {
                androidx.fragment.app.FragmentManager manager =
                    host.getSupportFragmentManager();
                // A unique tag per instance: a re-render can kill and rebuild
                // a picker while the previous fragment is still dismissing.
                fragment.show(manager, tag + "_"
                    + Integer.toHexString(System.identityHashCode(fragment)));
            } catch (Throwable t) {
                Log.e(TAG, "Could not show the Material picker", t);
            }
        });
    }

    /** Title, input mode and calendar bounds shared by both date pickers. */
    private static void configureDateBuilder(
            com.google.android.material.datepicker.MaterialDatePicker.Builder<?> builder,
            JSONObject p, long selection) {
        String title = p.optString("title", "");
        if (!title.isEmpty()) builder.setTitleText(title);

        // MaterialDatePicker ships a calendar grid; M3's "input" mode is the
        // same dialog with the text-entry toggle surfaced.
        if ("input".equals(p.optString("mode", "calendar"))) {
            builder.setInputMode(
                com.google.android.material.datepicker.MaterialDatePicker.INPUT_MODE_TEXT);
        }

        // ``firstDate`` / ``lastDate`` become real calendar constraints.
        String firstDate = p.optString("firstDate", "");
        String lastDate = p.optString("lastDate", "");
        if (!firstDate.isEmpty() || !lastDate.isEmpty()) {
            com.google.android.material.datepicker.CalendarConstraints.Builder
                constraints =
                    new com.google.android.material.datepicker.CalendarConstraints.Builder();
            if (!firstDate.isEmpty()) {
                constraints.setStart(isoDateMillis(firstDate, selection));
            }
            if (!lastDate.isEmpty()) {
                constraints.setEnd(isoDateMillis(lastDate, selection));
            }
            builder.setCalendarConstraints(constraints.build());
        }
    }

    /** Cancel handling shared by both date pickers. */
    private void wireDateDismiss(
            com.google.android.material.datepicker.MaterialDatePicker<?> picker,
            final String key, final PickerHost host) {
        picker.addOnNegativeButtonClickListener(v -> {
            host.markSettled();
            if (events != null) events.dispatch("cancel", key, null);
        });
        picker.addOnCancelListener(d -> {
            // Back press or a tap outside the sheet.
            host.markSettled();
            if (events != null) events.dispatch("cancel", key, null);
        });
    }

    private ShownPicker buildMaterialDatePicker(
            final String key, JSONObject p, final PickerHost host) {
        try {
            boolean range = p.optBoolean("range", false);
            long today = com.google.android.material.datepicker.MaterialDatePicker
                .todayInUtcMilliseconds();
            // ``selected`` is the ISO date the Python widget serialises;
            // ``selection`` (epoch millis) stays supported for raw payloads.
            long selection = isoDateMillis(
                p.optString("selected", p.optString("initial", "")),
                p.optLong("selection", today));

            final com.google.android.material.datepicker.MaterialDatePicker<?> picker;
            // ``setSelection`` takes the builder's own type parameter, so each
            // selection shape needs its concrete builder — a ``Builder<?>``
            // cannot be called with a typed selection.
            if (range) {
                com.google.android.material.datepicker.MaterialDatePicker.Builder<
                        androidx.core.util.Pair<Long, Long>> builder =
                    com.google.android.material.datepicker.MaterialDatePicker.Builder
                        .dateRangePicker();
                configureDateBuilder(builder, p, selection);
                builder.setSelection(new androidx.core.util.Pair<>(
                    isoDateMillis(p.optString("startDate", ""),
                                  p.optLong("start", selection)),
                    isoDateMillis(p.optString("endDate", ""),
                                  p.optLong("end", selection))));
                com.google.android.material.datepicker.MaterialDatePicker<
                    androidx.core.util.Pair<Long, Long>> typed = builder.build();
                // A non-dismissible picker keeps only its confirm button.
                typed.setCancelable(p.optBoolean("dismissible", true));
                typed.addOnPositiveButtonClickListener(span -> {
                    host.markSettled();
                    if (events == null || span == null) return;
                    JSONObject data = new JSONObject();
                    try {
                        long start = span.first == null ? 0L : span.first;
                        long end = span.second == null ? start : span.second;
                        data.put("start", start);
                        data.put("end", end);
                        data.put("startDate", isoDate(start));
                        data.put("endDate", isoDate(end));
                        data.put("value", start);
                        data.put("days", start != end);
                        data.put("confirmed", true);
                    } catch (Exception ignored) {}
                    events.dispatch("change", key, data);
                });
                wireDateDismiss(typed, key, host);
                picker = typed;
            } else {
                com.google.android.material.datepicker.MaterialDatePicker.Builder<Long>
                    builder = com.google.android.material.datepicker.MaterialDatePicker.Builder
                        .datePicker();
                configureDateBuilder(builder, p, selection);
                builder.setSelection(selection);
                com.google.android.material.datepicker.MaterialDatePicker<Long> typed =
                    builder.build();
                typed.setCancelable(p.optBoolean("dismissible", true));
                typed.addOnPositiveButtonClickListener(value -> {
                    host.markSettled();
                    if (events == null || value == null) return;
                    JSONObject data = new JSONObject();
                    try {
                        data.put("value", value);
                        data.put("date", isoDate(value));
                        data.put("confirmed", true);
                    } catch (Exception ignored) {}
                    events.dispatch("change", key, data);
                });
                wireDateDismiss(typed, key, host);
                picker = typed;
            }

            ShownPicker shown = materialFragment(picker, "pydrud_date_" + key);
            if (shown != null) return shown;
            Log.w(TAG, "No FragmentActivity host; using the system date picker");
        } catch (Throwable t) {
            // Never take the app down: fall back to a plain system dialog.
            Log.e(TAG, "MaterialDatePicker unavailable, using fallback", t);
        }
        return new ShownPicker(buildFallbackDateDialog(key, p, host));
    }

    private ShownPicker buildMaterialTimePicker(
            final String key, JSONObject p, final PickerHost host) {
        try {
            // ``is24hour`` is the Python widget's flag; ``use24h`` and
            // ``format`` remain for hand-built payloads.
            boolean twentyFour = p.optBoolean("is24hour",
                p.optBoolean("use24h", "24h".equals(p.optString("format", "24h"))));
            com.google.android.material.timepicker.MaterialTimePicker.Builder builder =
                new com.google.android.material.timepicker.MaterialTimePicker.Builder()
                    .setTimeFormat(twentyFour
                        ? com.google.android.material.timepicker.TimeFormat.CLOCK_24H
                        : com.google.android.material.timepicker.TimeFormat.CLOCK_12H);
            builder.setHour(p.optInt("hour", 0));
            builder.setMinute(p.optInt("minute", 0));
            String title = p.optString("title", "");
            if (!title.isEmpty()) builder.setTitleText(title);
            // M3's two time-picker modes: the clock dial, or the keyboard.
            if ("input".equals(p.optString("mode", "dial"))) {
                builder.setInputMode(
                    com.google.android.material.timepicker.MaterialTimePicker
                        .INPUT_MODE_KEYBOARD);
            }

            final com.google.android.material.timepicker.MaterialTimePicker picker =
                builder.build();
            picker.setCancelable(p.optBoolean("dismissible", true));
            picker.addOnPositiveButtonClickListener(v -> {
                host.markSettled();
                if (events == null) return;
                JSONObject data = new JSONObject();
                try {
                    data.put("hour", picker.getHour());
                    data.put("minute", picker.getMinute());
                    data.put("time", isoTime(picker.getHour(), picker.getMinute()));
                    data.put("confirmed", true);
                } catch (Exception ignored) {}
                events.dispatch("change", key, data);
            });
            picker.addOnNegativeButtonClickListener(v -> {
                host.markSettled();
                if (events != null) events.dispatch("cancel", key, null);
            });
            picker.addOnCancelListener(d -> {
                host.markSettled();
                if (events != null) events.dispatch("cancel", key, null);
            });

            ShownPicker shown = materialFragment(picker, "pydrud_time_" + key);
            if (shown != null) return shown;
            Log.w(TAG, "No FragmentActivity host; using the system time picker");
        } catch (Throwable t) {
            Log.e(TAG, "MaterialTimePicker unavailable, using fallback", t);
        }
        return new ShownPicker(buildFallbackTimeDialog(key, p, host));
    }

    /** Parse an ISO ``yyyy-MM-dd`` date; *fallback* when it is unusable. */
    private static long isoDateMillis(String value, long fallback) {
        String text = value == null ? "" : value.trim();
        if (text.length() != 10) return fallback;
        try {
            java.text.SimpleDateFormat fmt =
                new java.text.SimpleDateFormat("yyyy-MM-dd", java.util.Locale.US);
            fmt.setTimeZone(java.util.TimeZone.getTimeZone("UTC"));
            fmt.setLenient(false);
            java.util.Date parsed = fmt.parse(text);
            return parsed == null ? fallback : parsed.getTime();
        } catch (Exception ignored) {
            return fallback;
        }
    }

    /** Format epoch millis as an ISO ``yyyy-MM-dd`` date in UTC. */
    private static String isoDate(long millis) {
        java.text.SimpleDateFormat fmt =
            new java.text.SimpleDateFormat("yyyy-MM-dd", java.util.Locale.US);
        fmt.setTimeZone(java.util.TimeZone.getTimeZone("UTC"));
        return fmt.format(new java.util.Date(millis));
    }

    /** Format a 24-hour clock time as ``HH:mm``. */
    private static String isoTime(int hour, int minute) {
        return String.format(java.util.Locale.US, "%02d:%02d", hour, minute);
    }

    /** Last-resort date entry so the component still works without Material. */
    private android.app.Dialog buildFallbackDateDialog(
            final String key, JSONObject p, final PickerHost host) {
        java.util.Calendar cal = java.util.Calendar.getInstance();
        long selection = isoDateMillis(
            p.optString("selected", p.optString("initial", "")),
            p.optLong("selection", 0L));
        if (selection > 0L) cal.setTimeInMillis(selection);
        android.app.DatePickerDialog dialog = new android.app.DatePickerDialog(
            activity, (view, year, month, day) -> {
                host.markSettled();
                if (events == null) return;
                JSONObject data = new JSONObject();
                try {
                    java.util.Calendar chosen = java.util.Calendar.getInstance();
                    chosen.set(year, month, day);
                    long value = chosen.getTimeInMillis();
                    data.put("value", value);
                    data.put("date", isoDate(value));
                    data.put("year", year);
                    data.put("month", month + 1);
                    data.put("day", day);
                    data.put("confirmed", true);
                } catch (Exception ignored) {}
                events.dispatch("change", key, data);
            }, cal.get(java.util.Calendar.YEAR), cal.get(java.util.Calendar.MONTH),
            cal.get(java.util.Calendar.DAY_OF_MONTH));
        long firstDate = isoDateMillis(p.optString("firstDate", ""), 0L);
        long lastDate = isoDateMillis(p.optString("lastDate", ""), 0L);
        if (firstDate > 0L) dialog.getDatePicker().setMinDate(firstDate);
        if (lastDate > 0L) dialog.getDatePicker().setMaxDate(lastDate);
        dialog.setOnCancelListener(d -> {
            host.markSettled();
            if (events != null) events.dispatch("cancel", key, null);
        });
        return dialog;
    }

    /** Last-resort time entry. */
    private android.app.Dialog buildFallbackTimeDialog(
            final String key, JSONObject p, final PickerHost host) {
        boolean twentyFour = p.optBoolean("is24hour",
            p.optBoolean("use24h", "24h".equals(p.optString("format", "24h"))));
        android.app.TimePickerDialog dialog = new android.app.TimePickerDialog(
            activity, (view, hour, minute) -> {
                host.markSettled();
                if (events == null) return;
                JSONObject data = new JSONObject();
                try {
                    data.put("hour", hour);
                    data.put("minute", minute);
                    data.put("time", isoTime(hour, minute));
                    data.put("confirmed", true);
                } catch (Exception ignored) {}
                events.dispatch("change", key, data);
            }, p.optInt("hour", 0), p.optInt("minute", 0), twentyFour);
        dialog.setOnCancelListener(d -> {
            host.markSettled();
            if (events != null) events.dispatch("cancel", key, null);
        });
        return dialog;
    }

    // ══════════════════════════════════════════════════════════════════════
    // Connected button group, split button and docked toolbar
    // ══════════════════════════════════════════════════════════════════════

    /**
     * Material 3 connected button group.
     *
     * <p>The segments share one pill silhouette: the first keeps its outer
     * start corners, the last its outer end corners, and everything in
     * between is squared off. That connected profile is what makes an M3
     * button group read as a single control rather than a row of separate
     * buttons. Selection is dispatch-driven: tapping a segment reports its
     * index and the group redraws the selected pill.
     */
    private View createButtonGroup(final String key, JSONObject p) {
        final float radius = PydrudTheme.dp(PydrudTheme.radiusButton);
        final int dividerColor = PydrudTheme.alpha(PydrudTheme.outline, 0.55f);
        final boolean vertical =
            "vertical".equals(p.optString("orientation", "horizontal"));
        final int selected = p.optInt("selected", 0);

        LinearLayout group = new LinearLayout(activity) {
            private boolean styling = false;
            private int current = selected;

            private void applySegmentShapes() {
                if (styling) return;
                styling = true;
                try {
                    int n = getChildCount();
                    for (int i = 0; i < n; i++) {
                        View child = getChildAt(i);
                        if (child instanceof View
                            && child.getTag() != null
                            && "pydrud-divider".equals(child.getTag())) {
                            continue;
                        }
                        LayoutParams lp = (LayoutParams) child.getLayoutParams();
                        lp.topMargin = 0;
                        lp.bottomMargin = 0;
                        boolean first = i == 0;
                        boolean last = i == n - 1;
                        float[] corners = vertical
                            ? new float[]{
                                first ? radius : 0f, first ? radius : 0f,
                                first ? radius : 0f, first ? radius : 0f,
                                last ? radius : 0f, last ? radius : 0f,
                                last ? radius : 0f, last ? radius : 0f}
                            : new float[]{
                                first ? radius : 0f, first ? radius : 0f,
                                last ? radius : 0f, last ? radius : 0f,
                                last ? radius : 0f, last ? radius : 0f,
                                first ? radius : 0f, first ? radius : 0f};
                        GradientDrawable bg = new GradientDrawable();
                        bg.setShape(GradientDrawable.RECTANGLE);
                        bg.setCornerRadii(corners);
                        bg.setColor(i == current
                            ? PydrudTheme.secondaryContainer
                            : PydrudTheme.surfaceContainerLow);
                        bg.setStroke(Math.max(1, PydrudTheme.dp(PydrudTheme.dividerThickness)),
                            i == current ? PydrudTheme.primary : PydrudTheme.outlineVariant);
                        child.setBackground(bg);
                        child.setClickable(true);
                        final int index = i;
                        child.setOnClickListener(v -> {
                            current = index;
                            applySegmentShapes();
                            if (events != null) {
                                JSONObject data = new JSONObject();
                                try { data.put("index", index); } catch (Exception ignored) {}
                                events.dispatch("change", key, data);
                            }
                        });
                    }
                } finally {
                    styling = false;
                }
            }

            private void addDividers() {
                for (int i = getChildCount() - 1; i > 0; i--) {
                    View child = getChildAt(i);
                    if (child.getTag() != null
                        && "pydrud-divider".equals(child.getTag())) continue;
                    View divider = new View(getContext());
                    divider.setTag("pydrud-divider");
                    divider.setBackgroundColor(dividerColor);
                    LayoutParams dlp = vertical
                        ? new LayoutParams(LayoutParams.MATCH_PARENT,
                                           Math.max(1, PydrudTheme.dp(PydrudTheme.dividerThickness)))
                        : new LayoutParams(Math.max(1, PydrudTheme.dp(PydrudTheme.dividerThickness)),
                                           LayoutParams.MATCH_PARENT);
                    int inset = PydrudTheme.dp(vertical ? 0 : 10);
                    if (vertical) {
                        dlp.leftMargin = inset;
                        dlp.rightMargin = inset;
                    } else {
                        dlp.topMargin = inset;
                        dlp.bottomMargin = inset;
                    }
                    super.addView(divider, i, dlp);
                }
            }

            @Override public void addView(View child, int index,
                                          android.view.ViewGroup.LayoutParams params) {
                super.addView(child, index, params);
                if (styling) return;
                addDividers();
                applySegmentShapes();
            }
        };
        group.setGravity(Gravity.CENTER);
        group.setMinimumHeight(PydrudTheme.touchTarget());
        // Children land after this returns; the override above catches them.
        return group;
    }

    /**
     * Material 3 split button: a leading action plus a trailing menu
     * trigger, separated by a divider and sharing one pill outline.
     */
    private View createSplitButton(final String key, JSONObject p) {
        LinearLayout row = new LinearLayout(activity);
        row.setOrientation(LinearLayout.HORIZONTAL);
        row.setGravity(Gravity.CENTER_VERTICAL);

        float radius = PydrudTheme.dp(PydrudTheme.radiusButton);
        String variant = p.optString("variant", "filled");
        int accent = PydrudTheme.parse(p.optString("bg", ""), PydrudTheme.primary);
        int fill = accent;
        int label = PydrudTheme.onColorFor(accent);
        if ("tonal".equals(variant)) {
            fill = PydrudTheme.dark
                ? PydrudTheme.blend(accent, PydrudTheme.surface, 0.72f)
                : PydrudTheme.blend(accent, 0xFFFFFFFF, 0.86f);
            label = PydrudTheme.dark
                ? PydrudTheme.lighten(accent, 0.45f)
                : PydrudTheme.darken(accent, 0.35f);
        } else if ("outlined".equals(variant)) {
            fill = Color.TRANSPARENT;
            label = accent;
        }

        row.setBackground(fill == Color.TRANSPARENT
            ? PydrudTheme.outlineBackground(
                PydrudTheme.alpha(accent, 0.45f), radius,
                PydrudTheme.dp(PydrudTheme.borderWidth * 1.4f),
                PydrudTheme.alpha(accent, PydrudTheme.rippleOpacity))
            : PydrudTheme.buttonBackground(fill, radius, true));
        row.setMinimumHeight(PydrudTheme.adaptive(PydrudTheme.buttonHeightMd));

        String text = p.optString("label", "");
        if (!text.isEmpty()) {
            TextView primary = new TextView(activity);
            primary.setText(text);
            primary.setGravity(Gravity.CENTER_VERTICAL);
            primary.setPaddingRelative(PydrudTheme.dp(20), 0, PydrudTheme.dp(12), 0);
            PydrudTheme.applyTextDefaults(primary, PydrudTheme.textBody, 600, label);
            String icon = p.optString("icon", "");
            if (!icon.isEmpty()) {
                primary.setCompoundDrawablesRelativeWithIntrinsicBounds(
                    factory.icon(icon, label, PydrudTheme.dp(18)), null, null, null);
                primary.setCompoundDrawablePadding(PydrudTheme.dp(8));
            }
            primary.setClickable(true);
            primary.setOnClickListener(v -> {
                if (events != null) events.dispatch("click", key, null);
            });
            row.addView(primary, new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.WRAP_CONTENT,
                LinearLayout.LayoutParams.MATCH_PARENT));
        }

        View divider = new View(activity);
        divider.setBackgroundColor(PydrudTheme.alpha(label, 0.28f));
        LinearLayout.LayoutParams dlp = new LinearLayout.LayoutParams(
            Math.max(1, PydrudTheme.dp(PydrudTheme.dividerThickness)),
            LinearLayout.LayoutParams.MATCH_PARENT);
        int inset = PydrudTheme.dp(8);
        dlp.topMargin = inset;
        dlp.bottomMargin = inset;
        row.addView(divider, dlp);

        ImageView arrow = new ImageView(activity);
        arrow.setImageDrawable(factory.icon(
            p.optString("menuIcon", "arrow-drop-down"), label, PydrudTheme.dp(22)));
        arrow.setPadding(PydrudTheme.dp(12), 0, PydrudTheme.dp(12), 0);
        arrow.setClickable(true);
        arrow.setContentDescription(p.optBoolean("semantics", false)
            ? "More actions" : "More actions");
        row.addView(arrow, new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.WRAP_CONTENT,
            LinearLayout.LayoutParams.MATCH_PARENT));

        // The trailing half opens the related-actions menu.
        JSONArray items = p.optJSONArray("menuItems");
        final JSONArray menuItems = items == null ? new JSONArray() : items;
        arrow.setOnClickListener(v -> {
            if (menuItems.length() == 0) {
                // No menu declared — report the tap so Python can decide.
                if (events != null) events.dispatch("menu", key, null);
                return;
            }
            androidx.appcompat.widget.PopupMenu menu =
                new androidx.appcompat.widget.PopupMenu(activity, v);
            for (int i = 0; i < menuItems.length(); i++) {
                JSONObject item = menuItems.optJSONObject(i);
                String itemLabel = item == null ? "" : item.optString("label", "");
                menu.getMenu().add(android.view.Menu.NONE, i, i, itemLabel);
            }
            menu.setOnMenuItemClickListener(item -> {
                if (events == null) return true;
                JSONObject data = new JSONObject();
                try {
                    JSONObject src = menuItems.optJSONObject(item.getItemId());
                    data.put("index", item.getItemId());
                    data.put("value", src == null ? "" : src.optString("label", ""));
                    if (src != null && src.has("value")) {
                        data.put("value", src.optString("value", ""));
                    }
                } catch (Exception ignored) {}
                events.dispatch("select", key, data);
                return true;
            });
            menu.show();
        });

        return row;
    }

    /**
     * Material 3 docked toolbar — a pill-shaped surface that carries a
     * title plus frequently used actions.
     *
     * <p>``variant`` is ``small`` / ``medium`` / ``large`` to match the M3
     * toolbar sizes; medium and large reserve extra height for a headline.
     * The action widgets arrive as children, so they are pushed to the end
     * of the row by giving the title the remaining weight.
     */
    private View createToolbar(String key, JSONObject p) {
        LinearLayout bar = new LinearLayout(activity);
        bar.setOrientation(LinearLayout.HORIZONTAL);
        bar.setGravity(Gravity.CENTER_VERTICAL);

        String variant = p.optString("variant", "small");
        boolean large = "large".equals(variant);
        boolean medium = "medium".equals(variant);

        int bg = PydrudTheme.parse(p.optString("bg", ""), PydrudTheme.surfaceContainer);
        int fg = PydrudTheme.onSurface;

        float radius = PydrudTheme.dp(PydrudTheme.radiusToolbar);
        bar.setBackground(PydrudTheme.shape(bg, radius));
        bar.setPadding(PydrudTheme.dp(6), PydrudTheme.dp(6),
                       PydrudTheme.dp(6), PydrudTheme.dp(6));
        float height = PydrudTheme.toolbarHeight * (large ? 1.6f : medium ? 1.3f : 1f);
        bar.setMinimumHeight(PydrudTheme.adaptive(height));
        PydrudTheme.elevate(bar, PydrudTheme.elevationCard);
        PydrudTheme.addRipple(bar, PydrudTheme.alpha(fg, PydrudTheme.rippleOpacity),
            radius);

        String title = p.optString("title", "");
        if (!title.isEmpty()) {
            TextView tv = new TextView(activity);
            tv.setText(title);
            tv.setMaxLines(1);
            tv.setEllipsize(TextUtils.TruncateAt.END);
            PydrudTheme.applyTextDefaults(tv,
                large ? PydrudTheme.textHeadline : PydrudTheme.textLabel,
                large ? 400 : 600, fg);
            tv.setPaddingRelative(PydrudTheme.dp(12), 0, PydrudTheme.dp(8), 0);
            bar.addView(tv, new LinearLayout.LayoutParams(
                0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f));
        }
        return bar;
    }

    // ══════════════════════════════════════════════════════════════════════
    // Sheets
    // ══════════════════════════════════════════════════════════════════════

    /**
     * Material 3 standard (non-modal) bottom sheet — a persistent panel
     * anchored to the bottom of its parent, with the spec's top-only
     * rounding, container colour and drag handle.
     */
    private View createStandardBottomSheet(String key, JSONObject p) {
        LinearLayout sheet = new LinearLayout(activity);
        sheet.setOrientation(LinearLayout.VERTICAL);
        int bg = PydrudTheme.parse(p.optString("bg", ""), PydrudTheme.surfaceContainerLow);
        sheet.setBackground(PydrudTheme.topRoundedShape(
            bg, PydrudTheme.dp(PydrudTheme.radiusSheet)));
        PydrudTheme.elevate(sheet, PydrudTheme.elevationSheet);

        if (p.optBoolean("dragHandle", true)) {
            View handle = new View(activity);
            handle.setBackground(PydrudTheme.shape(
                PydrudTheme.alpha(PydrudTheme.onSurfaceVariant, 0.4f),
                PydrudTheme.dp(2)));
            LinearLayout.LayoutParams hlp = new LinearLayout.LayoutParams(
                PydrudTheme.dp(32), PydrudTheme.dp(4));
            hlp.gravity = Gravity.CENTER_HORIZONTAL;
            hlp.topMargin = PydrudTheme.dp(8);
            hlp.bottomMargin = PydrudTheme.dp(4);
            sheet.addView(handle, hlp);
        }
        sheet.setMinimumHeight(PydrudTheme.dp(96));
        return sheet;
    }

    /**
     * Material 3 side sheet — a panel that slides in from the start/end
     * edge with the spec's single-sided rounding.
     */
    private View createSideSheet(String key, JSONObject p) {
        LinearLayout sheet = new LinearLayout(activity);
        sheet.setOrientation(LinearLayout.VERTICAL);
        boolean end = !"start".equals(p.optString("side", "end"));
        int bg = PydrudTheme.parse(p.optString("bg", ""), PydrudTheme.surfaceContainerLow);
        float radius = PydrudTheme.dp(PydrudTheme.radiusSheet);
        sheet.setBackground(PydrudTheme.sideRoundedShape(bg, radius, end));
        PydrudTheme.elevate(sheet, PydrudTheme.elevationSheet);
        int width = (int) p.optDouble("width", PydrudTheme.sideSheetWidth);
        sheet.setMinimumWidth(PydrudTheme.adaptive(width));
        sheet.setPadding(PydrudTheme.dp(16), PydrudTheme.dp(16),
                         PydrudTheme.dp(16), PydrudTheme.dp(16));

        String title = p.optString("title", "");
        if (!title.isEmpty()) {
            TextView tv = new TextView(activity);
            tv.setText(title);
            tv.setMaxLines(1);
            tv.setEllipsize(TextUtils.TruncateAt.END);
            PydrudTheme.applyTextDefaults(tv, PydrudTheme.textTitle, 400,
                PydrudTheme.onSurfaceVariant);
            tv.setPadding(PydrudTheme.dp(4), PydrudTheme.dp(4),
                          PydrudTheme.dp(4), PydrudTheme.dp(12));
            sheet.addView(tv);
        }
        return sheet;
    }

    /**
     * Material 3 full-screen dialog — a dialog that owns the whole window,
     * headed by an M3 top app bar with a close affordance.
     */
    private View createFullScreenDialog(String key, JSONObject p) {
        final FrameLayout host = new FrameLayout(activity);
        host.addOnAttachStateChangeListener(new View.OnAttachStateChangeListener() {
            android.app.Dialog dialog;
            boolean selfClosing;

            @Override public void onViewAttachedToWindow(View v) {
                if (dialog != null) return;
                dialog = buildFullScreenDialog(key, p);
                dialog.setOnDismissListener(d -> {
                    dialog = null;
                    if (!selfClosing && events != null) {
                        events.dispatch("dismiss", key, null);
                    }
                });
                dialog.show();
            }

            @Override public void onViewDetachedFromWindow(View v) {
                if (dialog == null) return;
                selfClosing = true;
                dialog.dismiss();
                selfClosing = false;
                dialog = null;
            }
        });
        return host;
    }

    private android.app.Dialog buildFullScreenDialog(final String key, JSONObject p) {
        android.app.Dialog dialog = new android.app.Dialog(
            activity, com.google.android.material.R.style.Theme_Material3_DayNight_NoActionBar);
        LinearLayout column = new LinearLayout(activity);
        column.setOrientation(LinearLayout.VERTICAL);
        column.setBackgroundColor(PydrudTheme.parse(
            p.optString("bg", ""), PydrudTheme.surface));

        // M3 top app bar: close icon, title, optional confirm label.
        LinearLayout bar = new LinearLayout(activity);
        bar.setOrientation(LinearLayout.HORIZONTAL);
        bar.setGravity(Gravity.CENTER_VERTICAL);
        bar.setPaddingRelative(PydrudTheme.dp(4), PydrudTheme.dp(8),
                               PydrudTheme.dp(8), PydrudTheme.dp(8));
        bar.setMinimumHeight(PydrudTheme.dp(
            "large".equals(p.optString("variant", "small")) ? PydrudTheme.appBarHeightLarge
            : "medium".equals(p.optString("variant", "small")) ? PydrudTheme.appBarHeightMedium
            : PydrudTheme.appBarHeight));
        PydrudTheme.elevate(bar, PydrudTheme.elevationAppBar);

        ImageView close = new ImageView(activity);
        close.setImageDrawable(factory.icon(
            p.optString("closeIcon", "close"), PydrudTheme.onSurface,
            PydrudTheme.dp(24)));
        close.setPadding(PydrudTheme.dp(12), PydrudTheme.dp(12),
                         PydrudTheme.dp(12), PydrudTheme.dp(12));
        close.setClickable(true);
        final android.app.Dialog dialogRef = dialog;
        close.setOnClickListener(v -> {
            dialogRef.dismiss();
            if (events != null) events.dispatch("cancel", key, null);
        });
        bar.addView(close);

        String title = p.optString("title", "");
        if (!title.isEmpty()) {
            TextView tv = new TextView(activity);
            tv.setText(title);
            tv.setMaxLines(1);
            tv.setEllipsize(TextUtils.TruncateAt.END);
            PydrudTheme.applyTextDefaults(tv, PydrudTheme.textTitle, 400, PydrudTheme.onSurface);
            tv.setPadding(PydrudTheme.dp(8), 0, PydrudTheme.dp(8), 0);
            bar.addView(tv, new LinearLayout.LayoutParams(
                0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f));
        } else {
            bar.addView(new View(activity), new LinearLayout.LayoutParams(
                0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f));
        }

        String confirm = p.optString("confirm", "");
        if (!confirm.isEmpty()) {
            TextView cta = new TextView(activity);
            cta.setText(confirm);
            cta.setPadding(PydrudTheme.dp(16), PydrudTheme.dp(10),
                           PydrudTheme.dp(16), PydrudTheme.dp(10));
            PydrudTheme.applyTextDefaults(cta, PydrudTheme.textLabel, 600, PydrudTheme.primary);
            cta.setClickable(true);
            cta.setOnClickListener(v -> {
                if (events != null) events.dispatch("confirm", key, null);
                dialogRef.dismiss();
            });
            bar.addView(cta);
        }
        column.addView(bar, new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT,
            LinearLayout.LayoutParams.WRAP_CONTENT));

        View divider = new View(activity);
        divider.setBackgroundColor(PydrudTheme.outlineVariant);
        column.addView(divider, new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT, Math.max(1, PydrudTheme.dp(PydrudTheme.dividerThickness))));

        // Content host — ViewFactory attaches the children here.
        FrameLayout content = new FrameLayout(activity);
        column.addView(content, new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT, 0, 1f));

        dialog.setContentView(column);
        android.view.Window window = dialog.getWindow();
        if (window != null) {
            window.setLayout(LinearLayout.LayoutParams.MATCH_PARENT,
                             LinearLayout.LayoutParams.MATCH_PARENT);
        }
        dialog.setCancelable(p.optBoolean("dismissible", true));
        return dialog;
    }

    /** Bottom app bar with optional FAB cutout. */
    private View createBottomAppBar(String key, JSONObject props) {
        LinearLayout bar = new LinearLayout(activity);
        bar.setOrientation(LinearLayout.HORIZONTAL);
        bar.setGravity(Gravity.CENTER_VERTICAL);
        int pad = PydrudTheme.dp(8);
        bar.setPadding(pad, pad, pad, pad);
        bar.setMinimumHeight(PydrudTheme.dp(PydrudTheme.navHeight));
        String bg = props.optString("bg", "");
        bar.setBackgroundColor(bg.isEmpty()
            ? PydrudTheme.surface
            : PydrudTheme.parse(bg, PydrudTheme.surface));
        float elevation = (float) props.optDouble("elevation", 0);
        if (elevation > 0) PydrudTheme.elevate(bar, elevation);
        return bar;
    }

    /** FAB menu — expandable FAB with multiple actions. */
    private View createFABMenu(String key, JSONObject props) {
        FrameLayout wrapper = new FrameLayout(activity);
        wrapper.setLayoutParams(new FrameLayout.LayoutParams(
            FrameLayout.LayoutParams.WRAP_CONTENT,
            FrameLayout.LayoutParams.WRAP_CONTENT));
        String icon = props.optString("icon", "plus");
        View fab = createFAB(icon, key);
        FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(
            PydrudTheme.dp(PydrudTheme.fabSize),
            PydrudTheme.dp(PydrudTheme.fabSize));
        lp.gravity = Gravity.BOTTOM | Gravity.END;
        lp.bottomMargin = PydrudTheme.dp(24);
        lp.rightMargin = PydrudTheme.dp(24);
        wrapper.addView(fab, lp);
        return wrapper;
    }

    private View createFAB(String icon, String key) {
        FrameLayout fab = new FrameLayout(activity);
        fab.setBackground(PydrudTheme.ripple(
            PydrudTheme.shape(PydrudTheme.primary, PydrudTheme.dp(PydrudTheme.radiusFab)),
            PydrudTheme.rippleOn(PydrudTheme.primary),
            PydrudTheme.dp(PydrudTheme.radiusFab)));
        fab.setElevation(PydrudTheme.dp(PydrudTheme.elevationFab));
        ImageView iv = new ImageView(activity);
        iv.setImageDrawable(factory.icon(icon, PydrudTheme.onPrimary, 24));
        int iconPad = PydrudTheme.dp(16);
        fab.addView(iv, new FrameLayout.LayoutParams(
            FrameLayout.LayoutParams.MATCH_PARENT,
            FrameLayout.LayoutParams.MATCH_PARENT));
        iv.setPadding(iconPad, iconPad, iconPad, iconPad);
        fab.setOnClickListener(v -> {
            if (events != null) events.dispatch("click", key, null);
        });
        return fab;
    }

    /** Search view — full-screen search experience. */
    private View createSearchView(String key, JSONObject props) {
        LinearLayout container = new LinearLayout(activity);
        container.setOrientation(LinearLayout.VERTICAL);
        container.setBackgroundColor(PydrudTheme.surface);
        int pad = PydrudTheme.dp(16);
        container.setPadding(pad, pad, pad, pad);

        // Search input
        android.widget.EditText input = new android.widget.EditText(activity);
        input.setHint(props.optString("hint", "Search"));
        input.setBackground(PydrudTheme.inputBackground(
            PydrudTheme.surfaceContainerHighest,
            PydrudTheme.surfaceContainerHighest,
            PydrudTheme.dp(PydrudTheme.radiusChip),
            PydrudTheme.outline, PydrudTheme.primary,
            PydrudTheme.dp(PydrudTheme.borderWidth)));
        input.setPadding(PydrudTheme.dp(16), PydrudTheme.dp(12),
                         PydrudTheme.dp(16), PydrudTheme.dp(12));
        PydrudTheme.applyTextDefaults(input, 16, 400, PydrudTheme.onSurface);
        container.addView(input, new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT,
            LinearLayout.LayoutParams.WRAP_CONTENT));
        input.addTextChangedListener(new android.text.TextWatcher() {
            public void beforeTextChanged(CharSequence s, int a, int b, int c) {}
            public void onTextChanged(CharSequence s, int a, int b, int c) {}
            public void afterTextChanged(android.text.Editable s) {
                JSONObject data = new JSONObject();
                try { data.put("value", s.toString()); } catch (Exception ignored) {}
                if (events != null) events.dispatch("change", key, data);
            }
        });
        return container;
    }

    /** Loading indicator — M3 Expressive waveform indicator. */
    private View createLoadingIndicator(JSONObject props) {
        ProgressBar pb = new ProgressBar(activity);
        pb.setIndeterminate(true);
        String color = props.optString("color", "");
        if (!color.isEmpty()) {
            pb.getIndeterminateDrawable().setColorFilter(
                PydrudTheme.parse(color, PydrudTheme.primary),
                android.graphics.PorterDuff.Mode.SRC_IN);
        }
        float size = (float) props.optDouble("size", 48);
        pb.setLayoutParams(new FrameLayout.LayoutParams(
            PydrudTheme.dp(size), PydrudTheme.dp(size)));
        return pb;
    }
