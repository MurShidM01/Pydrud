    "The key must be an application-specific resource id" at runtime, which
    used to kill every Slider, Switch, Checkbox, Chip, Tabs and
    ExpansionTile the renderer built. These IDs are the keys the generated
    Java layer uses for its internal view tags.
-->
<resources>
    <item name="pydrud_tag_range" type="id"/>
    <item name="pydrud_tag_listener" type="id"/>
    <item name="pydrud_tag_children" type="id"/>
</resources>
